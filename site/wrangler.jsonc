// Cloudflare: the built site served as static assets from a Worker (`bun run deploy`). The
// Worker itself only runs for the videos, to answer the byte-range requests Safari needs.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bridgetown",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Every deploy builds first, which also measures the videos for the Worker (worker/media.json).
  "build": { "command": "bun run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"],
  },
}
