# Every response: no type sniffing, never framed, only the origin as referrer elsewhere, HTTPS
# from the first visit on (this host only: other hosts under the domain are not ours to bind),
# and none of the devices the page never uses.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Hashed build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Films and posters: long-lived, but they can be replaced in place.
/media/*
  Cache-Control: public, max-age=604800

# The hero's pre-rendered frames and loops: fixed for a given render.
/hero/*
  Cache-Control: public, max-age=604800
