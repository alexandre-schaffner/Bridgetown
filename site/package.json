{
  "name": "bridgetown-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/media-manifest.mjs && astro check && tsc -p tsconfig.tools.json && astro build && node scripts/csp.mjs",
    "preview": "astro preview",
    "test": "node scripts/media-manifest.mjs && bun test",
    "e2e": "bun scripts/e2e.ts",
    "record": "bun scripts/record.ts",
    "deploy": "node scripts/ci-only.mjs && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.3.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-static": "^1.55.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/bun": "^1.4.3",
    "@types/three": "^0.186.0",
    "playwright-core": "1.64.1",
    "sharp": "^0.35.5",
    "typescript": "6",
    "wrangler": "^4.149.0"
  }
}
