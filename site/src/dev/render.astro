---
// The frame renderer, served by `astro dev` only (astro.config.mjs): the arch scene at offline
// quality, one exact frame per call (render.ts), to pre-render the hero.
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Bridgetown · frame renderer</title>
  </head>
  <body>
    <canvas data-scene></canvas>
    <script>
      import "./render";
    </script>
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    overflow: hidden;
    background: #050608;
  }

  canvas {
    display: block;
    width: 100vw;
    height: 100vh;
  }
</style>
