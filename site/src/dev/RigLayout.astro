---
// The page both film rigs (launch.astro, island.astro) are drawn on: the arch's canvas, the
// flood of day over it, and the shots in the slot above both. rig.ts drives them.
import "../styles/global.css";

interface Props {
  /** The film, in the tab's title. */
  title: string;
  /** The rig's class on <html>, which its styles hang from. */
  rig: string;
}
const { title, rig } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={["js", rig]}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Bridgetown · {title}</title>
    <script is:inline>
      // `?vt` puts the page on a virtual clock (Date, performance, frames, timers, CSS and Web
      // Animations) that only moves when the recorder (scripts/record.ts) calls
      // `__advance(ms)`. Every frame of the film is then drawn at its exact time, whatever it
      // costs to draw. Without it the film plays in real time.
      (() => {
        if (!new URLSearchParams(location.search).has("vt")) return;
        let now = 0;
        const d0 = Date.now();
        const p0 = performance.now();
        Date.now = () => d0 + now;
        performance.now = () => p0 + now;

        let frames = new Map();
        let nextId = 1;
        window.requestAnimationFrame = (cb) => (frames.set(nextId, cb), nextId++);
        window.cancelAnimationFrame = (id) => frames.delete(id);

        const timers = new Map();
        const later = (fn, ms, args, every) => {
          const id = nextId++;
          timers.set(id, { at: now + Math.max(0, ms || 0), fn, args, every });
          return id;
        };
        window.setTimeout = (fn, ms, ...args) => later(fn, ms, args, 0);
        window.setInterval = (fn, ms, ...args) => later(fn, ms, args, Math.max(1, ms || 0));
        window.clearTimeout = window.clearInterval = (id) => timers.delete(id);

        // Each animation's own time, moved by hand.
        const clocks = new WeakMap();
        const animations = (ms) => {
          for (const a of document.getAnimations()) {
            if (!clocks.has(a)) {
              clocks.set(a, a.currentTime ?? 0);
              a.pause();
            }
            const t = clocks.get(a) + ms * (a.playbackRate || 1);
            clocks.set(a, t);
            const end = a.effect?.getComputedTiming().endTime ?? 0;
            if (Number.isFinite(end) && t >= end) a.finish();
            else a.currentTime = t;
          }
        };

        window.__advance = (ms) => {
          const target = now + ms;
          for (;;) {
            let due = null;
            for (const [id, t] of timers) if (t.at <= target && (!due || t.at < due[1].at)) due = [id, t];
            if (!due) break;
            const [id, t] = due;
            now = Math.max(now, t.at);
            if (t.every) t.at += t.every;
            else timers.delete(id);
            typeof t.fn === "function" ? t.fn(...t.args) : 0;
          }
          now = target;
          animations(ms);
          const run = frames;
          frames = new Map();
          for (const cb of run.values()) cb(p0 + now);
        };
      })();
    </script>
  </head>
  <body>
    <canvas class="scene" data-scene></canvas>
    <div class="flood" data-flood></div>
    <slot />
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    cursor: none;
  }

  .scene {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
  }

  /* Day, laid over the arch as the camera goes through it. */
  .flood {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: var(--day);
    opacity: 0;
    pointer-events: none;
  }
</style>
