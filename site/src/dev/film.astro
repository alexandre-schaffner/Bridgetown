---
// The film rig, served by `astro dev` only (astro.config.mjs): the site's own components played
// on a timeline (film.ts), to be recorded (scripts/record.ts). `?cut=keynote` is the product
// film at 1920 × 1080, `?cut=launch` its 30-second cut, `?cut=island` the short notch
// recording at 1600 × 996.
import ArchMark from "../components/ArchMark.astro";
import Journey from "../components/Journey.astro";
import MacScreen from "../components/MacScreen.astro";
import Outcomes from "../components/Outcomes.astro";
import RigLayout from "./RigLayout.astro";
---

<RigLayout title="film rig" rig="film">
  <!-- Night cards over the arch. -->
  <div class="card night-card high" data-card="title">
    <p class="mark"><ArchMark size={44} /></p>
    <h1>Bridgetown</h1>
  </div>
  <div class="card night-card low" data-card="promise">
    <p class="big">Your alerts, handled<br />before you look.</p>
  </div>
  <div class="card night-card low" data-card="question">
    <p class="big">Every alert gets one question.<br /><span class="soft">Can an agent finish this, or does it need you?</span></p>
  </div>

  <!-- Day: the notch. -->
  <section class="scene-day" data-card="notch">
    <h2 class="day-title">It lives in the notch.</h2>
    <div class="mac-wrap" data-island-root>
      <MacScreen class="film-mac" />
    </div>
    <p class="caption" data-caption></p>
  </section>

  <!-- Day: the agents' path. -->
  <section class="scene-day journey-wrap" data-card="journey">
    <Journey />
  </section>

  <!-- Night: the light. -->
  <div class="card night-card corner" data-card="light">
    <h2 class="light-title">Read the light.</h2>
    <p class="light-caption" data-light-caption></p>
  </div>

  <!-- Day: outcomes. -->
  <section class="scene-day outcomes-wrap" data-card="outcomes">
    <Outcomes />
  </section>

  <!-- Night: the end. -->
  <div class="card night-card high end" data-card="end">
    <p class="mark"><ArchMark size={36} /></p>
    <h2>Bridgetown</h2>
    <p class="end-line">Early access, for macOS 14 or later.</p>
  </div>

  <!-- Launch cut: its own words. -->
  <div class="card night-card low" data-card="l-alerts">
    <p class="big">Every alert. Every mention.<br /><span class="soft">Read the moment it lands.</span></p>
  </div>
  <div class="card night-card low" data-card="l-agents">
    <p class="big">Agents take what they can finish.<br /><span class="soft">You get the rest.</span></p>
  </div>
  <div class="card night-card high" data-card="l-intro">
    <p class="kick">Introducing</p>
    <p class="mark"><ArchMark size={40} /></p>
    <h2 class="intro-name">Bridgetown</h2>
    <p class="end-line">Your alerts, handled before you look.</p>
    <p class="end-line soft-small">Early access, for macOS 14 or later.</p>
  </div>

  <script>
    import "./film";
  </script>
</RigLayout>

<style>
  :global(html.film) {
    background: #050608;
  }

  [data-card] {
    position: fixed;
    inset: 0;
    z-index: 2;
    opacity: 0;
    visibility: hidden;
  }

  .night-card {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.5rem;
    color: var(--night-ink);
    text-align: center;
    pointer-events: none;
  }

  .night-card.low {
    place-content: end center;
    padding-bottom: 12vh;
  }

  .night-card.low::before {
    content: "";
    position: absolute;
    inset: 45% 0 0;
    z-index: -1;
    background: linear-gradient(180deg, transparent, oklch(0.1 0.006 255 / 0.8));
  }

  .night-card.high {
    place-content: start center;
    padding-top: 15vh;
  }

  .night-card.corner {
    place-content: start start;
    justify-items: start;
    padding: 9vh 7vw;
    text-align: left;
  }

  h1 {
    font-size: 7.5rem;
    font-weight: 580;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .mark {
    color: var(--night-ink);
  }

  .big {
    font-size: 4.25rem;
    font-weight: 560;
    letter-spacing: -0.032em;
    line-height: 1.06;
  }

  .soft {
    color: var(--night-dim);
  }

  .scene-day {
    background: var(--day);
    color: var(--ink);
  }

  [data-card="notch"] {
    display: grid;
    grid-template-rows: auto auto auto;
    align-content: center;
    justify-items: center;
    gap: 2.5rem;
  }

  .day-title {
    font-size: 4rem;
    letter-spacing: -0.035em;
  }

  .mac-wrap {
    width: 86vw;
  }

  .mac-wrap :global(.film-mac) {
    width: 100%;
  }

  .caption {
    min-height: 2em;
    font-size: 1.5rem;
    color: var(--ink-dim);
    letter-spacing: -0.01em;
  }

  .journey-wrap {
    overflow: hidden;
  }

  .journey-wrap :global(.journey) {
    height: 100vh !important;
  }

  .journey-wrap :global([data-journey-pin]) {
    position: relative !important;
  }

  .outcomes-wrap {
    display: grid;
    align-content: center;
  }

  .light-title {
    font-size: 6rem;
    letter-spacing: -0.04em;
  }

  .light-caption {
    font-size: 2rem;
    color: var(--night-dim);
    min-height: 1.3em;
  }

  .end h2 {
    font-size: 6.5rem;
    letter-spacing: -0.04em;
  }

  .kick {
    font-size: 1.5rem;
    color: var(--night-dim);
    letter-spacing: -0.01em;
  }

  .intro-name {
    font-size: 7rem;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .soft-small {
    font-size: 1.25rem !important;
    color: var(--night-faint) !important;
  }

  .end-line {
    font-size: 1.75rem;
    color: var(--night-dim);
  }

  /* The island cut: just the screen, edge to edge, all of it. */
  :global(html.cut-island) [data-card="notch"] {
    gap: 0;
    padding: 0;
    align-content: start;
  }

  :global(html.cut-island) .day-title,
  :global(html.cut-island) .caption {
    display: none;
  }

  :global(html.cut-island) .mac-wrap {
    width: 100vw;
  }

  :global(html.cut-island) .mac-wrap :global(.screen) {
    height: 900px;
  }

  :global(html.cut-island) .mac-wrap :global(.bezel) {
    height: calc(900px * var(--k) + 14px);
    border-radius: 0;
    mask-image: none;
    -webkit-mask-image: none;
  }
</style>
