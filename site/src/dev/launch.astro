---
// The launch film rig, served by `astro dev` only (astro.config.mjs): the noise, the name, the
// notch, then the real app (src/assets/app/, captured by scripts/showcase-screenshots.sh), cut
// to a 120 BPM grid by launch.ts, which also reports the cues its score is built from. Drawn at
// a fixed 1920 × 1080, in pixels; the shots share launch.css.
import RigLayout from "./RigLayout.astro";
import End from "./shots/End.astro";
import Models from "./shots/Models.astro";
import Noise from "./shots/Noise.astro";
import Notch from "./shots/Notch.astro";
import Screen from "./shots/Screen.astro";
import Title from "./shots/Title.astro";
import Turn from "./shots/Turn.astro";
import alertWatch from "../assets/app/alert-watch.png";
import overview from "../assets/app/overview.png";
import sessionCi from "../assets/app/session-ci.png";
import sessionMerge from "../assets/app/session-merge.png";
import sessionMerged from "../assets/app/session-merged.png";
import sessionReview from "../assets/app/session-review.png";
import sessionRunning from "../assets/app/session-running.png";
import "./launch.css";
---

<!-- Shots stack in this order, which shows where one leaves over another; launch.ts plays them
     in its own. -->
<RigLayout title="launch film" rig="launch">
  <Noise />
  <Turn />
  <Title />
  <Notch />
  <Screen
    shot="glance"
    kick="One glance"
    screens={[{ name: "overview", src: overview.src }]}
    captions={[
      "The whole picture, in one screen.",
      "Production, <span class=dim>as it is right now.</span>",
      "What needs you, <span class=dim>and only that.</span>",
      "What the agents are doing.",
    ]}
  />
  <Screen
    shot="agents"
    kick="Agents"
    screens={[
      { name: "running", src: sessionRunning.src },
      { name: "review", src: sessionReview.src },
      { name: "ci", src: sessionCi.src },
      { name: "merge", src: sessionMerge.src },
      { name: "merged", src: sessionMerged.src },
    ]}
    captions={[
      "An agent diagnoses and fixes it, <span class=dim>in its own worktree.</span>",
      "A second model reviews the fix.",
      "CI runs. <span class=dim>Red goes back to the agent, not to you.</span>",
      "Ready to merge. <span class=dim>That click is yours.</span>",
      "Then the release, <span class=dim>and the deploy is followed.</span>",
    ]}
  />
  <Screen
    shot="watch"
    kick="Production"
    screens={[{ name: "watch", src: alertWatch.src }]}
    captions={[
      "It watches production, too.",
      "Even when no alert has fired.",
      "One click, and an agent investigates.",
    ]}
  />
  <Models />
  <End />

  <script>
    import "./launch";
  </script>
</RigLayout>
