---
// The launch film rig, served by `astro dev` only (astro.config.mjs): every feature, one shot
// each, cut to a 120 BPM grid (launch.ts directs it, and reports the cues its score is built
// from). Drawn at a fixed 1920 × 1080, in pixels.
import ArchMark from "../components/ArchMark.astro";
import Icon from "../components/Icon.astro";
import MacScreen from "../components/MacScreen.astro";
import { areaPath, linePath, series } from "../lib/spark";
import RigLayout from "./RigLayout.astro";

// Triage: what Jev answers for each message, and where the policy sends it.
const triage = [
  {
    from: "#alert-api",
    who: "Monitor",
    text: "5xx rate 3.1% on /v4/orders over 5 minutes",
    answers: [["Needs action now", 93], ["An agent can fix it", 86], ["A teammate is on it", 5]],
    route: ["Agent starts", "blue"],
  },
  {
    from: "Direct message",
    who: "Priya",
    text: "Should we ship the pricing change today, or hold it for Monday?",
    answers: [["Waiting on you", 96], ["An agent can do it", 4], ["Already answered", 2]],
    route: ["Needs you", "amber"],
  },
  {
    from: "#eng-api",
    who: "Jonas",
    text: "@alex the orders page 500s when region is empty, can you take a look?",
    answers: [["Waiting on you", 91], ["An agent can do it", 78], ["Already answered", 3]],
    route: ["Agent drafts, you send", "blue"],
  },
  {
    from: "#alert-billing",
    who: "Monitor",
    text: "Invoice job failed 3 times in a row",
    answers: [["Needs action now", 88], ["An agent can fix it", 71], ["A teammate is on it", 82]],
    route: ["Sam is on it", "grey"],
  },
  {
    from: "#alert-releases",
    who: "Deploy bot",
    text: "web v2.15.0 deployed to production",
    answers: null,
    route: ["Filtered by a rule", "grey"],
  },
] as const;

// Depth picks the model; this is the only table that names one.
const depths = [
  { depth: "quick", model: "Sonnet", effort: "medium", fill: 0.34, example: "A flaky check, a typo in a config" },
  { depth: "standard", model: "Opus", effort: "high", fill: 0.67, example: "A 5xx on one route, a failing job" },
  { depth: "deep", model: "Opus", effort: "max", fill: 1, example: "A regression across services" },
];

// Calibration: verdicts kept with their numbers, labelled with a thumb.
const verdicts = [
  { from: "#alert-api", who: "Monitor", text: "5xx rate 3.1% on /v4/orders over 5 minutes", route: ["Agent started", "blue"], nums: "actionable 93% · agent 86%" },
  { from: "#alert-jobs", who: "Monitor", text: "cron rewards-sync exceeded 15 min", route: ["Suggested to you", "amber"], nums: "actionable 61% · agent 72%" },
  { from: "#eng-infra", who: "Julien", text: "is the Base indexer behind again?", route: ["Needs you", "amber"], nums: "needs you 84% · agent 9%" },
] as const;

// Health: the header's strip, a quiet dot per service until one isn't.
const services = ["Slack", "Jev", "GitHub", "Grafana"];

const rail = ["Diagnose", "Fix", "Draft PR", "Second review", "CI", "Review request", "Merge", "Release", "Deploy"];
const rise = [...series(40, 12, 3, 9), 14, 22, 41, 63, 71, 69, 74, 72];
const diff: [number, string, string][] = [
  [41, "", "  const query = parseQuery(req)"],
  [42, "del", "- const region = Number(query.region)"],
  [42, "add", "+ if (!query.region) {"],
  [43, "add", '+   return badRequest("region is required")'],
  [44, "add", "+ }"],
  [45, "add", "+ const region = Number(query.region)"],
  [46, "", "  const orders = await findOrders(region)"],
];

// Watch: the overview's signals, and the one that rose.
const signals = [
  ["API 5xx", 11, 9],
  ["API p99", 340, 4],
  ["Engine errors", 6, 2],
  ["Job errors", 3, 7],
  ["eRPC errors", 18, 5],
  ["Failed job pods", 1, 11],
  ["OOM kills", 0.4, 13],
  ["DB waits", 22, 6],
] as const;
const CW = 1040;
const CH = 500;
const steady = series(33, 11, 2.6, 3);
const watchValues = [...steady, 38, 64, 71];
const usual = [...steady].sort((a, b) => a - b)[Math.floor(steady.length * 0.9)]!;
const cy = (v: number) => 30 + (1 - v / 80) * (CH - 60);
const riseX = (CW * (watchValues.length - 3)) / (watchValues.length - 1) - 14;

const logStream = [
  'level=error msg="deadlock detected on relation 48211" job=rewards-sync',
  'level=warn msg="rate limited by rpc.ankr.com, retry in 1200ms" job=erpc',
  'level=info msg="computed 18402 leaves for campaign 0x8f3c…2a1b"',
  'level=error msg="deadlock detected on relation 48207" job=campaigns-sync',
  'level=info msg="merkle root posted on chain 42161 block 288104512"',
  'level=warn msg="token 0x5f98…ab32 retired by issuer, skipping"',
  'level=error msg="deadlock detected on relation 48211" job=rewards-sync',
  'level=info msg="GET /v4/opportunities 200 41ms"',
  'level=warn msg="rate limited by rpc.ankr.com, retry in 2400ms" job=erpc',
  'level=info msg="dispute window closes in 3600s for chain 8453"',
  'level=error msg="deadlock detected on relation 48233" job=campaigns-sync',
  'level=info msg="GET /v4/users/0x91…c2/rewards 200 88ms"',
];
const patterns = [
  { text: 'deadlock detected on relation <n>', jobs: "rewards-sync, campaigns-sync", tag: "New", n: "412 today", answers: [91, 64, 58] },
  { text: "rate limited by rpc.ankr.com, retry in <n>ms", jobs: "erpc", tag: "6.8× usual", n: "1,904 in 2h", answers: [77, 81, 22] },
  { text: "token <addr> retired by issuer, skipping", jobs: "rewards-sync", tag: "Risky", n: "steady", answers: [84, 70, 66] },
];

const refusals = [
  ["git push --force origin main", "Force pushes are refused. Push to fix-bt-api-empty-region."],
  ["gh pr merge 3352 --squash", "Merging is a human gate. It waits in Needs you."],
  ["kubectl rollout restart deploy/api", "No cluster tools. Prod is read through Grafana."],
  ["curl https://engine.internal.merkl.xyz/admin", "Internal hosts are out of reach."],
  ["cast send 0x8f3c…2a1b \"claim()\"", "No transactions from a session."],
];
const guarantees = [
  "No secrets in reach",
  "Every shell command parsed and checked",
  "Writes stay in the worktree",
  "Slack text is data, never instructions",
  "Dry run: one switch, nothing posted",
];

const outcomes = [
  { word: "Resolved", dot: "green", evidence: "Deployed api v1.35.12. The release tracker confirmed it at 10:31." },
  { word: "Closed", dot: "grey", evidence: "Root cause not found. Nothing shipped, and the card says so." },
  { word: "Failed", dot: "red", evidence: "e2e failed twice after the fix. Handed back to you with the logs." },
  { word: "Stopped", dot: "grey", evidence: "You stopped it during Fix. Its worktree is kept for you." },
];
const lights = [
  ["rest", "Cool white", "Nothing is waiting on you."],
  ["working", "Blue lamps", "Agents are at work."],
  ["needs-you", "Amber", "A decision is yours."],
  ["paused", "Dim", "Paused. Alerts are still read."],
];
const montage = ["Triage.", "Diagnose.", "Fix.", "Review.", "Ship.", "Watch.", "Guard."];

// A session, live: the daemon's six steps, and its transcript as the app prints it.
const phases = [["Diagnose", "done"], ["Fix", "done"], ["PR", "current"], ["Review", ""], ["CI", ""], ["Deploy", ""]];
const transcript = [
  ["10:04", "tool", "› Grep “region” src/routes"],
  ["10:04", "tool", "› Read src/routes/orders.ts"],
  ["10:05", "text", "An empty region is parsed as 0, and findOrders(0) throws."],
  ["10:06", "tool", "› Edit src/routes/orders.ts"],
  ["10:06", "tool", "› Bash bun test routes/orders"],
  ["10:07", "status", "· 214 pass · 0 fail"],
];

// Prod: the overview's three numbers, then a board per view, swiped between.
const boards = [
  { name: "Incidents", charts: [["API 5xx", 11, 9], ["API p99", 340, 4], ["Engine errors", 6, 2], ["Job errors", 3, 7]] },
  { name: "Infra", charts: [["eRPC errors", 18, 5], ["Failed job pods", 1, 11], ["OOM kills", 0.4, 13], ["Postgres", 22, 6]] },
  { name: "Database", charts: [["Connections", 140, 3], ["Lock waits", 22, 8], ["Longest transaction", 4, 12], ["Replication lag", 0.6, 10]] },
] as const;

// Settings → Behaviour, as the app has it.
const toggles = [
  { label: "Start agents automatically", on: true },
  { label: "Adversarial review", on: true, note: "Codex reviews every fix before the PR leaves draft." },
  { label: "Watch prod", on: true, note: "Signals every 5 minutes, logs every 10." },
  { label: "Watch my mentions & DMs everywhere", on: true },
  { label: "Quiet hours", on: false, flip: "No notifications during quiet hours. Auto-start keeps running." },
  { label: "Dry run", on: false, flip: "Agents still run, but nothing is posted to Slack." },
  { label: "Launch at login", on: true },
];

// And everything else: the wall of features, one tile each, around the name.
const more: [string, string][] = [
  ["filter", "Rules first: no model call for a deploy notice"],
  ["repeat", "Repeats join the session that owns them"],
  ["at-sign", "Mentions, team mentions and DMs"],
  ["gauge", "Sonnet, Opus or Opus max, by depth"],
  ["git-branch", "One worktree per agent"],
  ["shield-check", "Codex review, up to 4 rounds"],
  ["map", "Revv walkthrough in every review request"],
  ["tag", "Next version worked out for you"],
  ["rocket", "Deploys confirmed by the release tracker"],
  ["search", "Investigate anyway"],
  ["rotate-ccw", "Retry a failed agent"],
  ["message-square-reply", "Message an agent mid-run"],
  ["sliders-horizontal", "Thresholds you set"],
  ["eye", "A teammate’s 👀 means it’s theirs"],
  ["scroll-text", "Prod → Logs, opened in Grafana Explore"],
  ["chart-line", "Rises and spikes against the usual"],
  ["users", "Teammates’ agents, in your notch"],
  ["bell", "Notifications for what’s yours"],
  ["moon", "Quiet hours"],
  ["key", "Tokens in your Keychain"],
  ["smile", "Slack mrkdwn and emoji, rendered"],
  ["undo-2", "Two-finger swipe back"],
  ["vibrate", "Haptics on the trackpad"],
  ["accessibility", "Reduce Motion, respected"],
  ["power", "Launch at login"],
  ["square-stop", "Stop any agent, keep its worktree"],
  ["terminal", "Take over in Terminal"],
  ["cloud-off", "Says so when it can’t see"],
];
---

<RigLayout title="launch film" rig="launch">
  <!-- 1 · The noise. -->
  <section class="shot" data-shot="noise">
    <div class="cam"><div class="wall" data-wall></div></div>
    <div class="veil"></div>
    <div class="tally mono">
      <p><b data-count="alerts">0</b> alerts</p>
      <p><b data-count="mentions">0</b> mentions</p>
      <p><b data-count="dms">0</b> messages</p>
      <p class="clock" data-clock>09:12</p>
    </div>
  </section>

  <section class="shot center" data-shot="turn-a">
    <h2 class="hl" data-split>Most of it doesn’t need you.</h2>
  </section>
  <section class="shot center" data-shot="turn-b">
    <h2 class="hl" data-split>The rest <span class="dim">can’t wait.</span></h2>
  </section>

  <!-- 2 · The name, over the arch. -->
  <section class="shot over high" data-shot="title">
    <p class="mark"><ArchMark size={56} /></p>
    <h1 class="name" data-split>Bridgetown</h1>
  </section>
  <section class="shot over low" data-shot="tagline">
    <p class="tag-line" data-split>Your alerts, handled <span class="dim">before you look.</span></p>
  </section>

  <!-- Chapter cards. -->
  <section class="shot center chapter" data-shot="ch-triage">
    <p class="kick mono">01 · Triage</p>
    <h2 class="hl" data-split>One question<br />for every message.</h2>
  </section>
  <section class="shot center chapter" data-shot="ch-agents">
    <p class="kick mono">02 · Agents</p>
    <h2 class="hl" data-split>Agents take it<br /><span class="dim">all the way.</span></h2>
  </section>
  <section class="shot center chapter" data-shot="ch-watch">
    <p class="kick mono">03 · Watch</p>
    <h2 class="hl" data-split>It watches prod.<br /><span class="dim">Even when Slack is quiet.</span></h2>
  </section>

  <!-- 3 · Triage. -->
  <section class="shot" data-shot="triage">
    <div class="cam">
      <div class="triage">
        <header class="t-head">
          <p class="eyebrow"><span class="jev">Jev</span> TypeSafe System One · one call per message</p>
          <p class="eyebrow right">Rules first · then Jev · then your policy</p>
        </header>
        <ol class="t-log">
          <li class="t-cols mono"><span>Message</span><span>Jev’s answers</span><span>Route</span></li>
          {
            triage.map((row) => (
              <li class="t-row" data-trow>
                <div class="t-msg">
                  <p class="t-meta"><span class="mono">{row.from}</span><span>{row.who}</span></p>
                  <p class="t-text">{row.text}</p>
                </div>
                <div class="t-answers">
                  {row.answers ? (
                    row.answers.map(([q, p]) => (
                      <div class="t-a" style={`--p:${p / 100}`}>
                        <span class="q">{q}</span>
                        <span class="bar"><i /></span>
                        <span class="pct mono" data-pct={p}>0%</span>
                      </div>
                    ))
                  ) : (
                    <p class="t-rule mono">Matched a rule: a successful deploy.<br />No model call.</p>
                  )}
                </div>
                <p class="t-route" data-troute>
                  <i class={`dot dot-${row.route[1]}`} />
                  <span>{row.route[0]}</span>
                </p>
              </li>
            ))
          }
        </ol>
        <div class="policy">
          <span class="p-label">Start an agent when Jev is at least</span>
          <span class="p-track"><i data-pfill></i><b data-pthumb></b></span>
          <span class="p-val mono" data-pval>75%</span>
          <span class="p-label dim">sure it can finish the job</span>
        </div>
      </div>
    </div>
  </section>

  <section class="shot" data-shot="depth">
    <div class="cam depth">
      <h2 class="hl-m" data-split>Depth picks the model.</h2>
      <div class="d-grid">
        {
          depths.map((d) => (
            <div class="d-card" data-dcard>
              <p class="d-depth mono">{d.depth}</p>
              <p class="d-model">{d.model}</p>
              <p class="d-effort">{d.effort} effort</p>
              <span class="d-meter"><i style={`--f:${d.fill}`} /></span>
              <p class="d-ex">{d.example}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="shot" data-shot="calibrate">
    <div class="cam calibrate">
      <div class="team-copy">
        <h2 class="hl-m" data-split>Tell it when <span class="dim">it’s wrong.</span></h2>
        <p class="sub" data-split>Every verdict is kept with its numbers. A thumb labels it for calibration.</p>
      </div>
      <ol class="verdicts">
        {
          verdicts.map((v) => (
            <li class="v-row" data-vrow>
              <p class="t-meta"><span class="mono">{v.from}</span><span>{v.who}</span></p>
              <p class="v-text">{v.text}</p>
              <p class="v-route"><i class={`dot dot-${v.route[1]}`} /> {v.route[0]} <span class="faint mono">{v.nums}</span></p>
              <div class="v-fb">
                <span class="v-q" data-vq>Was this the right call?</span>
                <span class="thumb" data-thumb><Icon name="thumbs-up" size={24} /></span>
                <span class="thumb" data-thumb><Icon name="thumbs-down" size={24} /></span>
              </div>
            </li>
          ))
        }
      </ol>
      <svg class="pointer big" data-pointer width="34" height="34" viewBox="0 0 22 22"><path d="M4 2.5v15.2l3.9-3.6 2.5 5.6 2.6-1.1-2.4-5.5h5.3z" fill="#000" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"></path></svg>
    </div>
  </section>

  <!-- 4 · The agents' path, Diagnose to Deploy. -->
  <section class="shot" data-shot="pipe">
    <ol class="rail">
      {rail.map((s, i) => (
        <li data-rail class:list={[(i === 6 || i === 7) && "yours"]}><i></i><span>{s}</span></li>
      ))}
    </ol>
    <div class="viewport">
      <ol class="track" data-track>
        <li class="frame" data-frame>
          <p class="step mono">1 · Diagnose</p>
          <h3>Finds what broke, and says so plainly.</h3>
          <div class="panel" data-in>
            <p class="panel-head"><span>Route 5xx · /v4/orders</span><span class="mono faint">Grafana · last hour</span></p>
            <svg viewBox="0 0 1000 220" preserveAspectRatio="none" class="chart">
              <path d={areaPath(rise, 1000, 220, 14)} class="area" data-area />
              <path d={linePath(rise, 1000, 220, 14)} class="line" pathLength="1" data-draw />
              <line x1="820" x2="820" y1="0" y2="220" class="deploy" />
            </svg>
            <p class="panel-sub mono" data-in>api v1.35.11 deployed 4 min before the rise</p>
            <p class="diag" data-in><b>Diagnosis</b> /v4/orders parses an empty <code>region</code> as <code>0</code>, and the lookup throws. The change came in with v1.35.11.</p>
          </div>
        </li>
        <li class="frame" data-frame>
          <p class="step mono">2 · Fix</p>
          <h3>Changes the code, on its own branch.</h3>
          <div class="panel code" data-in>
            <p class="panel-head mono"><span>src/routes/orders.ts</span><span class="faint">fix-bt-api-empty-region · +4 −1</span></p>
            <pre>{diff.map(([n, kind, text]) => (
              <span class:list={["dl", kind]} data-in><span class="ln">{n}</span>{text}{"\n"}</span>
            ))}</pre>
            <p class="panel-foot mono" data-in><span class="ok">✓</span> 214 pass · 0 fail</p>
          </div>
        </li>
        <li class="frame" data-frame>
          <p class="step mono">3 · Draft PR</p>
          <h3>Opens a draft, with the reasoning attached.</h3>
          <div class="panel" data-in>
            <p class="pr-title">fix(api): reject an empty region on /v4/orders <span class="faint">#3352</span></p>
            <p class="pr-meta"><span class="pill">Draft</span><span class="mono faint">fix-bt-api-empty-region</span></p>
            <div class="pr-body">
              <p data-in><b>Root cause.</b> An empty region was parsed as 0 since v1.35.11.</p>
              <p data-in><b>Fix.</b> Reject it with a 400 before the lookup.</p>
              <p data-in><b>Tested.</b> A unit test for the empty, missing and valid cases.</p>
            </div>
          </div>
        </li>
        <li class="frame" data-frame>
          <p class="step mono">4 · Second review</p>
          <h3>Another vendor’s model reads every diff.</h3>
          <div class="panel" data-in>
            <p class="panel-head"><span>Codex · read-only sandbox</span><span class="mono faint">Jev judges each finding</span></p>
            <ul class="rounds">
              <li data-in><span class="r mono">Round 1</span><span>A negative region still reaches the lookup.</span><span class="tag tag-amber">Blocking · 91%</span></li>
              <li data-in><span class="r"></span><span>Name the constant for the error message.</span><span class="tag">Dropped · nitpick</span></li>
              <li data-in><span class="r"></span><span>Agent: validates <code>region &gt; 0</code>, adds a test.</span><span class="tag">Fixed</span></li>
              <li data-in><span class="r mono">Round 2</span><span>No blocking findings.</span><span class="tag tag-green">Passed</span></li>
            </ul>
          </div>
        </li>
        <li class="frame" data-frame>
          <p class="step mono">5 · CI</p>
          <h3>Waits for green, and fixes what isn’t.</h3>
          <div class="panel" data-in>
            <p class="panel-head"><span>Out of draft · checks</span><span class="mono faint">#3352</span></p>
            <ul class="checks">
              <li data-check><span class="ok">✓</span> lint <span class="faint mono">18s</span></li>
              <li data-check><span class="ok">✓</span> typecheck <span class="faint mono">41s</span></li>
              <li data-check><span class="ok">✓</span> unit <span class="faint mono">1m 12s</span></li>
              <li data-check><span class="ok">✓</span> e2e · orders <span class="faint mono">3m 05s</span></li>
            </ul>
          </div>
        </li>
        <li class="frame" data-frame>
          <p class="step mono">6 · Review request</p>
          <h3>Asks a person to look.</h3>
          <div class="panel slack" data-in>
            <p class="slack-ch mono">#general-approvals</p>
            <div class="slack-msg" data-in>
              <span class="avatar">A</span>
              <div>
                <p><b>Alex</b> <span class="faint">via Bridgetown · 10:12</span></p>
                <p>🤖 <span class="link">PR #3352</span> is green and ready for review: reject an empty region on /v4/orders.</p>
                <p class="revv" data-in><Icon name="map" size={16} /> <span class="link">Revv walkthrough</span> <span class="faint">· 4 steps · 3 min</span></p>
              </div>
            </div>
          </div>
        </li>
        <li class="frame yours" data-frame>
          <p class="step mono"><i class="dot dot-amber"></i> 7 · Merge · Yours</p>
          <h3>You press Merge.</h3>
          <div class="panel" data-in>
            <div class="act">
              <span class="glyph green"><Icon name="git-merge" size={22} /></span>
              <span><b>Merge fix(api): reject an empty region</b><span class="faint">#3352 · Approved · CI green</span></span>
              <span class="primary" data-press>Merge</span>
            </div>
            <ul class="evidence" data-in>
              <li><span class="ok">✓</span> Approved by Julien</li>
              <li><span class="ok">✓</span> CI green · 4 checks</li>
              <li><span class="ok">✓</span> Second review passed</li>
            </ul>
            <svg class="pointer" data-pointer width="28" height="28" viewBox="0 0 22 22"><path d="M4 2.5v15.2l3.9-3.6 2.5 5.6 2.6-1.1-2.4-5.5h5.3z" fill="#000" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"></path></svg>
          </div>
        </li>
        <li class="frame yours" data-frame>
          <p class="step mono"><i class="dot dot-amber"></i> 8 · Release · Yours</p>
          <h3>You cut the release.</h3>
          <div class="panel" data-in>
            <div class="act">
              <span class="glyph"><Icon name="package" size={22} /></span>
              <span><b>Ship api v1.35.12</b><span class="faint">Merged · next version worked out for you</span></span>
              <span class="primary" data-press>Cut v1.35.12</span>
            </div>
            <ul class="evidence" data-in>
              <li><span class="faint">Next</span> v1.35.12</li>
              <li><span class="faint">Changes</span> 1 PR · #3352</li>
              <li><span class="faint">Tag</span> pushed by you, never an agent</li>
            </ul>
            <svg class="pointer" data-pointer width="28" height="28" viewBox="0 0 22 22"><path d="M4 2.5v15.2l3.9-3.6 2.5 5.6 2.6-1.1-2.4-5.5h5.3z" fill="#000" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"></path></svg>
          </div>
        </li>
        <li class="frame" data-frame>
          <p class="step mono">9 · Deploy</p>
          <h3>Follows it to production.</h3>
          <div class="panel" data-in>
