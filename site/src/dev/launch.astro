    height: 10px;
    border-radius: 50%;
    flex: none;
    background: var(--lo);
  }

  :global(.launch .dot-blue) {
    background: var(--blue);
    box-shadow: 0 0 14px var(--blue);
  }

  :global(.launch .dot-amber) {
    background: var(--amber);
