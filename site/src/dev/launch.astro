  }

  .faint {
    color: var(--lo);
  }

  .shot {
    position: fixed;
    inset: 0;
    z-index: 2;
    opacity: 0;
    visibility: hidden;
    background: #000;
    perspective: 2400px;
    overflow: hidden;
  }

  /* Over the arch: no background of its own. */
  .shot.over {
    background: transparent;
    display: grid;
    justify-items: center;
    text-align: center;
    pointer-events: none;
  }

  .shot.over.high {
    align-content: start;
    padding-top: 150px;
    gap: 22px;
  }

  .shot.over.low {
    align-content: end;
    padding-bottom: 130px;
  }

  .shot.over.low::before {
    content: "";
    position: absolute;
    inset: 50% 0 0;
    z-index: -1;
    background: linear-gradient(180deg, transparent, rgb(0 0 0 / 0.75));
  }

  .shot.center {
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: 36px;
  }

  .cam {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* Words that rise out of their own line. */
  :global(.w) {
    display: inline-block;
    overflow: hidden;
    padding: 0.06em 0.02em 0.14em;
    margin: -0.06em -0.02em -0.14em;
    vertical-align: top;
  }

  :global(.wi) {
    display: inline-block;
    will-change: transform, filter;
  }

  .hl {
    font-size: 140px;
    font-weight: 620;
    letter-spacing: -0.048em;
    line-height: 1.02;
    color: var(--hi);
  }

  .hl-m {
    font-size: 96px;
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1.02;
    color: var(--hi);
  }

  .hl-s {
