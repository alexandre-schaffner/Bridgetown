    background: var(--mid);
  }

  .ok {
    color: var(--green);
  }

  /* MARK: Noise */

  .wall {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2600px;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
    translate: -50% -50%;
    transform-style: preserve-3d;
  }

  :global(.note) {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 14px;
    align-items: start;
    padding: 18px 20px;
    border-radius: 18px;
    background: rgb(28 28 30 / 0.92);
    box-shadow:
      inset 0 0 0 1px var(--hair),
      0 30px 60px rgb(0 0 0 / 0.5);
    opacity: 0;
  }

  :global(.note .av) {
    display: grid;
    place-content: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: #2c2c2e;
    color: var(--hi);
    font-weight: 600;
    font-size: 19px;
  }

  :global(.note .av.alert) {
    background: #3a1d1d;
    color: #ffb4a8;
  }

  :global(.note .ch) {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 15px;
    color: var(--mid);
  }

  :global(.note .tx) {
    margin-top: 4px;
    font-size: 19px;
    line-height: 1.32;
    color: var(--hi);
  }

  .veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 68%, rgb(0 0 0 / 0.92) 92%),
      radial-gradient(ellipse 70% 70% at 50% 50%, transparent 40%, #000 100%);
    pointer-events: none;
  }

  .tally {
    position: absolute;
    left: 90px;
    bottom: 80px;
    display: flex;
    gap: 56px;
    align-items: baseline;
    font-size: 22px;
    color: var(--mid);
  }

  .tally b {
    font-size: 64px;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--hi);
    font-variant-numeric: tabular-nums;
    margin-right: 10px;
  }

  .tally .clock {
    position: fixed;
    right: 90px;
    bottom: 80px;
    font-size: 22px;
  }

  /* MARK: Triage */

  .triage {
    position: absolute;
    left: 140px;
    right: 140px;
    top: 120px;
  }

  .t-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .eyebrow {
    font-size: 20px;
    color: var(--mid);
  }

  .jev {
    display: inline-block;
    margin-right: 10px;
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--hi);
    color: #000;
    font-weight: 600;
  }

  .t-log {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair-strong);
  }

  .t-cols,
  .t-row {
    display: grid;
    grid-template-columns: 1.2fr 1fr 360px;
    gap: 60px;
  }

  .t-cols {
    padding: 14px 0;
    font-size: 16px;
    color: var(--lo);
    border-bottom: 1px solid var(--hair);
  }

  .t-row {
    padding: 22px 0;
    border-bottom: 1px solid var(--hair);
    align-items: center;
    opacity: 0.12;
  }

  .t-meta {
    display: flex;
    gap: 14px;
    font-size: 17px;
    color: var(--lo);
  }

  .t-meta .mono {
    color: var(--mid);
  }

  .t-text {
    margin-top: 6px;
    font-size: 26px;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--hi);
  }

  .t-answers {
    display: grid;
    gap: 9px;
  }

  .t-a {
    display: grid;
    grid-template-columns: 210px 1fr 64px;
    gap: 16px;
    align-items: center;
    font-size: 17px;
    color: var(--mid);
  }

  .bar {
    height: 4px;
    border-radius: 2px;
    background: var(--hair);
    overflow: hidden;
  }

  .bar i {
    display: block;
    height: 100%;
    background: var(--hi);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  .pct {
    text-align: right;
    color: var(--hi);
    font-variant-numeric: tabular-nums;
  }

  .t-rule {
    font-size: 17px;
    color: var(--lo);
    line-height: 1.5;
  }

  .t-route {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 26px;
    font-weight: 560;
    letter-spacing: -0.015em;
    color: var(--hi);
  }

  .policy {
    display: grid;
    grid-template-columns: auto 520px 80px auto;
    gap: 24px;
    align-items: center;
    margin-top: 34px;
    font-size: 20px;
    color: var(--mid);
  }

  .p-track {
    position: relative;
    height: 4px;
    border-radius: 2px;
    background: var(--hair-strong);
  }

  .p-track i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 55.5%;
    border-radius: 2px;
    background: var(--hi);
  }

  .p-track b {
    position: absolute;
    left: 55.5%;
    top: 50%;
    width: 24px;
    height: 24px;
    margin: -12px 0 0 -12px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.6);
  }

  .p-val {
    color: var(--hi);
    font-size: 26px;
  }

  .depth {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 80px;
  }

  .d-grid {
    display: grid;
    grid-template-columns: repeat(3, 460px);
    gap: 32px;
  }

  .d-card {
    padding: 40px;
    border-radius: 28px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--hair);
  }

  .d-depth {
    font-size: 20px;
    color: var(--mid);
  }

  .d-model {
    margin-top: 28px;
    font-size: 76px;
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--hi);
  }

  .d-effort {
    margin-top: 8px;
    font-size: 26px;
    color: var(--mid);
  }

  .d-meter {
    display: block;
    margin: 34px 0 24px;
    height: 6px;
    border-radius: 3px;
    background: var(--hair);
    overflow: hidden;
  }

  .d-meter i {
    display: block;
    height: 100%;
    width: calc(var(--f) * 100%);
    background: var(--hi);
    transform-origin: 0 50%;
  }

  .d-ex {
    font-size: 19px;
    color: var(--lo);
  }

  /* MARK: Pipe */

  .rail {
    position: absolute;
    top: 76px;
    left: 140px;
    right: 140px;
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    z-index: 2;
  }

  .rail li {
    display: grid;
    gap: 12px;
    font-size: 16px;
    color: var(--lo);
    transition: color 300ms;
  }

  .rail li i {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--hair);
    transition: background 300ms;
  }

  .rail li:global(.done) {
    color: var(--hi);
  }

  .rail li:global(.done) i {
    background: var(--hi);
  }

  .rail li.yours:global(.done) i {
    background: var(--amber);
  }

  .viewport {
    position: absolute;
    inset: 0;
  }

  .track {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    gap: 160px;
    margin: 0;
    padding: 0;
    list-style: none;
    will-change: transform;
  }

  .frame {
    flex: none;
    width: 1200px;
    padding-top: 250px;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 20px;
    color: var(--mid);
  }

  .frame h3 {
    margin: 14px 0 40px;
    font-size: 64px;
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--hi);
  }

  .panel {
    position: relative;
    padding: 34px 38px;
    border-radius: 26px;
    background: var(--card);
    box-shadow:
      inset 0 0 0 1px var(--hair),
      0 40px 120px rgb(0 0 0 / 0.6),
      0 0 160px oklch(0.63 0.19 252 / 0.06);
    font-size: 22px;
    color: var(--mid);
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    font-size: 19px;
    color: var(--hi);
    margin-bottom: 18px;
  }

  .chart {
    display: block;
    width: 100%;
    height: 220px;
  }

  .chart .area {
    fill: oklch(0.63 0.19 252 / 0.12);
  }

  .chart .line {
    fill: none;
    stroke: var(--hi);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .chart .deploy {
    stroke: var(--amber);
    stroke-dasharray: 4 6;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .panel-sub {
    margin-top: 14px;
    font-size: 17px;
    color: var(--amber);
  }

  .diag {
    margin-top: 18px;
    font-size: 24px;
    line-height: 1.45;
    color: var(--hi);
  }

  .diag b {
    margin-right: 8px;
    color: var(--mid);
    font-weight: 500;
  }

  code {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 1px 6px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.08);
  }

  .code pre {
    margin: 0;
    font-family: var(--mono);
    font-size: 21px;
    line-height: 1.75;
    color: var(--mid);
  }

  .dl {
    display: block;
    padding: 0 10px;
    border-radius: 6px;
  }

  .dl.add {
    color: #b9f0cf;
    background: oklch(0.62 0.12 158 / 0.14);
  }

  .dl.del {
    color: #ffc1b8;
    background: oklch(0.6 0.19 22 / 0.14);
  }

  .ln {
    display: inline-block;
    width: 44px;
    color: var(--lo);
  }

  .panel-foot {
    margin-top: 18px;
    font-size: 19px;
    color: var(--hi);
  }

  .pr-title {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--hi);
  }

  .pr-meta {
    display: flex;
    gap: 16px;
    align-items: center;
    margin: 14px 0 24px;
    font-size: 18px;
  }

  .pill {
    padding: 4px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--hair-strong);
    color: var(--hi);
    font-size: 17px;
  }

  .pr-body {
    display: grid;
    gap: 12px;
    padding-top: 22px;
    border-top: 1px solid var(--hair);
    font-size: 24px;
    color: var(--mid);
  }

  .pr-body b {
    color: var(--hi);
    font-weight: 560;
  }

  .rounds,
  .checks,
  .tracker {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rounds li {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 16px 0;
    border-top: 1px solid var(--hair);
    font-size: 23px;
    color: var(--hi);
  }

  .r {
    font-size: 17px;
    color: var(--lo);
  }

  .tag {
    padding: 4px 12px;
    border-radius: 8px;
    font-size: 16px;
    font-family: var(--mono);
    color: var(--mid);
    box-shadow: inset 0 0 0 1px var(--hair-strong);
    white-space: nowrap;
  }

  .tag-amber {
    color: var(--amber);
    box-shadow: inset 0 0 0 1px oklch(0.8 0.15 74 / 0.5);
  }

  .tag-green {
    color: var(--green);
    box-shadow: inset 0 0 0 1px oklch(0.62 0.12 158 / 0.5);
  }

  .checks li,
  .tracker li {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid var(--hair);
    font-size: 28px;
    color: var(--hi);
  }

  .checks li .faint,
  .tracker li .faint {
    margin-left: auto;
    font-size: 19px;
  }

  .tracker li.prod {
    font-weight: 560;
  }

  .slack-ch {
    font-size: 18px;
    color: var(--lo);
    margin-bottom: 18px;
  }

  .slack-msg {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 18px;
    font-size: 24px;
    line-height: 1.45;
    color: var(--hi);
  }

  .slack-msg + .slack-msg,
  .tracker + .slack-msg {
    margin-top: 26px;
  }

  .avatar {
    display: grid;
    place-content: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: #2c2c2e;
    font-weight: 600;
    color: var(--hi);
  }

  .avatar.bot {
    background: var(--hi);
    color: #000;
  }

  .avatar.maya {
    background: oklch(0.5 0.1 160);
  }

  .link {
    color: oklch(0.74 0.14 252);
  }

  .revv {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    padding: 12px 16px;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--hair);
    width: max-content;
  }

  .act {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: 22px;
    align-items: center;
  }

  .act b {
    display: block;
    font-size: 28px;
    font-weight: 560;
    letter-spacing: -0.015em;
    color: var(--hi);
  }

  .act .faint {
    font-size: 20px;
  }

  .evidence {
    display: flex;
    gap: 14px;
    margin: 30px 0 0;
    padding: 26px 0 0;
    list-style: none;
    border-top: 1px solid var(--hair);
  }

  .evidence li {
    padding: 10px 18px;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--hair);
    font-size: 20px;
    color: var(--hi);
  }

  .glyph {
    display: grid;
    place-content: center;
    width: 60px;
    height: 60px;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px var(--hair-strong);
    color: var(--hi);
  }

  .glyph.green {
    color: var(--green);
  }

  .primary,
  .g-btn,
  .chip.primary {
    display: inline-block;
    padding: 14px 30px;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.01em;
  }

  .pointer {
    position: absolute;
    left: 60%;
    top: 140%;
    z-index: 5;
    filter: drop-shadow(0 4px 8px rgb(0 0 0 / 0.5));
  }

  /* MARK: Notch (day) */

  .dusk {
    position: absolute;
    inset: 0;
    z-index: 10;
    background: #000;
    opacity: 0;
    pointer-events: none;
  }

  .day-shot {
    background: var(--day);
    color: var(--ink);
  }

  .notch {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 44px;
  }

  .day-title {
    font-size: 80px;
    font-weight: 620;
    letter-spacing: -0.045em;
  }

  .mac-wrap {
    width: 1640px;
  }

  .mac-wrap :global(.film-mac) {
    width: 100%;
  }

  .caption {
    min-height: 1.4em;
    font-size: 28px;
    color: var(--ink-dim);
    letter-spacing: -0.01em;
  }

  /* MARK: Gates */

  .gates {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 90px;
  }

  .g-row {
    display: grid;
    grid-template-columns: repeat(3, 480px);
    gap: 40px;
  }

  .g {
    display: grid;
    justify-items: center;
    gap: 26px;
    padding: 50px 30px 44px;
    border-radius: 30px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--hair);
    text-align: center;
  }

  .g-kind {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 19px;
    color: var(--amber);
  }

  .g-btn {
    padding: 22px 54px;
    font-size: 40px;
    letter-spacing: -0.025em;
  }

  .g-d {
    font-size: 21px;
    color: var(--lo);
  }

  .g-foot {
    font-size: 40px;
    font-weight: 560;
    letter-spacing: -0.03em;
    color: var(--mid);
  }

  .pointer.big {
    left: 0;
    top: 0;
  }

  /* MARK: Ask */

  .ask {
    display: grid;
    grid-template-columns: 760px 760px;
    gap: 80px;
    justify-content: center;
    align-content: center;
  }

  .ask-col {
    display: grid;
    gap: 44px;
    align-content: start;
  }

  .card {
    position: relative;
    padding: 34px 36px;
    border-radius: 26px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--hair);
    min-height: 470px;
  }

  .c-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 19px;
    color: var(--mid);
  }

  .c-meta .faint {
    margin-left: auto;
  }

  .c-q {
    margin-top: 20px;
    font-size: 30px;
    line-height: 1.32;
    letter-spacing: -0.02em;
    color: var(--hi);
  }

  .c-replies {
    display: flex;
    gap: 14px;
    margin-top: 30px;
  }

  .c-replies.end {
    justify-content: flex-end;
  }

  .chip {
    padding: 12px 24px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--hair-strong);
    font-size: 22px;
    color: var(--hi);
  }

  .chip.primary {
    padding: 12px 26px;
    font-size: 22px;
  }

  .chip:global(.picked) {
    background: #fff;
    color: #000;
  }

  .c-after {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: 30px;
    font-size: 21px;
    color: var(--mid);
    opacity: 0;
  }

  .draft {
    margin-top: 24px;
    padding: 20px 22px;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px var(--hair);
    background: rgb(255 255 255 / 0.03);
  }

  .d-label {
    font-size: 16px;
    color: var(--lo);
  }

  .d-text {
    margin-top: 8px;
    min-height: 3.9em;
    font-size: 23px;
    line-height: 1.4;
    color: var(--hi);
  }

  /* MARK: Watch */

  .watch {
    display: grid;
    grid-template-columns: 420px 1100px;
    gap: 80px;
    justify-content: center;
    align-content: center;
  }

  .signals {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .s-head {
    padding-bottom: 16px;
    font-size: 17px;
    color: var(--lo);
  }

  .sig {
    display: grid;
    grid-template-columns: 1fr 140px;
    align-items: center;
    padding: 20px 0;
    border-top: 1px solid var(--hair);
    font-size: 26px;
    color: var(--mid);
  }

  .sig svg {
    width: 140px;
    height: 28px;
  }

  .sig path {
    fill: none;
    stroke: var(--lo);
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
  }

  .sig.hot {
    color: var(--hi);
  }

  .sig.hot path {
    stroke: var(--amber);
  }

  .w-chart {
    position: relative;
    margin: 0;
    padding: 30px 30px 26px;
    border-radius: 26px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--hair);
  }

  .w-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 22px;
    font-size: 20px;
    color: var(--hi);
  }

  .w-chart svg {
    display: block;
    width: 1040px;
    height: 500px;
  }

  .w-chart .line {
    fill: none;
    stroke: var(--hi);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .w-chart .usual {
    stroke: var(--lo);
    stroke-dasharray: 3 6;
    vector-effect: non-scaling-stroke;
  }

  .w-chart .rise {
    fill: oklch(0.8 0.15 74 / 0.1);
    opacity: 0;
  }

  .usual-label {
    position: absolute;
    left: 40px;
    font-size: 15px;
    color: var(--lo);
  }

  .finding {
    position: absolute;
    right: 120px;
    top: 100px;
    width: 440px;
    padding: 24px 26px;
    border-radius: 18px;
    background: #1c1c1e;
    box-shadow:
      inset 0 0 0 1px var(--hair-strong),
      0 30px 80px rgb(0 0 0 / 0.7);
    display: grid;
    gap: 10px;
    opacity: 0;
  }

  .f-kind,
  .f-session {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 19px;
    color: var(--hi);
  }

  .f-text {
    font-size: 21px;
    line-height: 1.35;
    color: var(--hi);
  }

  .f-session {
    padding-top: 10px;
