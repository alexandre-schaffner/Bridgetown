---
// A worktree, never the keys: the commands an agent is refused, and why.

const refusals = [
  ["git push --force origin main", "Force pushes are refused. Push to fix-bt-api-empty-region."],
  ["gh pr merge 3352 --squash", "Merging is a human gate. It waits in Needs you."],
  ["kubectl rollout restart deploy/api", "No cluster tools. Prod is read through Grafana."],
  ["curl https://engine.internal.merkl.xyz/admin", "Internal hosts are out of reach."],
  ["cast send 0x8f3c…2a1b \"claim()\"", "No transactions from a session."],
];
const guarantees = [
  "No secrets in reach",
  "Every shell command parsed and checked",
  "Writes stay in the worktree",
  "Slack text is data, never instructions",
  "Dry run: one switch, nothing posted",
];
---

<section class="shot" data-shot="safety">
  <div class="cam safety">
    <div class="s-copy">
      <h2 class="hl-m">A worktree.<br /><span class="dim">Never the keys.</span></h2>
      <ul class="guarantees">{guarantees.map((g) => <li data-g><span class="ok">✓</span> {g}</li>)}</ul>
    </div>
    <div class="term">
      <div class="chrome"><i></i><i></i><i></i><span class="mono">fix-bt-api-empty-region — agent</span></div>
      <div class="term-body mono" data-term>
        {refusals.map(([cmd, why]) => (
          <div class="ref" data-ref>
            <p class="cmd"><span class="p">$</span> <span data-type={cmd}></span></p>
            <p class="why"><span class="x">✕</span> {why}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .safety {
    display: grid;
    grid-template-columns: 700px 980px;
    gap: 80px;
    justify-content: center;
    align-content: center;
  }

  .s-copy {
    display: grid;
    gap: 56px;
    align-content: center;
  }

  .guarantees {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guarantees li {
    padding: 18px 0;
    border-top: 1px solid var(--hair);
    font-size: 30px;
    letter-spacing: -0.01em;
    color: var(--hi);
    opacity: 0.15;
  }

  .ref {
    margin-bottom: 20px;
    opacity: 0;
  }

  .why {
    color: #ff9f94;
    opacity: 0;
  }

  .x {
    margin-right: 6px;
  }
</style>
