---
// The noise: a wall of Slack notifications (launch.ts deals them in) and the tally running
// up under it.
---

<section class="shot" data-shot="noise">
  <div class="cam"><div class="wall" data-wall></div></div>
  <div class="veil"></div>
  <div class="tally mono">
    <p><b data-count="alerts">0</b> alerts</p>
    <p><b data-count="mentions">0</b> mentions</p>
    <p><b data-count="dms">0</b> messages</p>
    <p class="clock" data-clock>09:12</p>
  </div>
</section>

<style>
  .wall {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2600px;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
    translate: -50% -50%;
    transform-style: preserve-3d;
  }

  :global(.note) {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 14px;
    align-items: start;
    padding: 18px 20px;
    border-radius: 18px;
    background: rgb(28 28 30 / 0.92);
    box-shadow:
      inset 0 0 0 1px var(--hair),
      0 30px 60px rgb(0 0 0 / 0.5);
    opacity: 0;
  }

  :global(.note .av) {
    display: grid;
    place-content: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: #2c2c2e;
    color: var(--hi);
    font-weight: 600;
    font-size: 19px;
  }

  :global(.note .av.alert) {
    background: #3a1d1d;
    color: #ffb4a8;
  }

  :global(.note .ch) {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 15px;
    color: var(--mid);
  }

  :global(.note .tx) {
    margin-top: 4px;
    font-size: 19px;
    line-height: 1.32;
    color: var(--hi);
  }

  .tally {
    position: absolute;
    left: 90px;
    bottom: 80px;
    display: flex;
    gap: 56px;
    align-items: baseline;
    font-size: 22px;
    color: var(--mid);
  }

  .tally b {
    font-size: 64px;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--hi);
    font-variant-numeric: tabular-nums;
    margin-right: 10px;
  }

  .tally .clock {
    position: fixed;
    right: 90px;
    bottom: 80px;
    font-size: 22px;
  }
</style>
