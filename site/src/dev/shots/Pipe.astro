---
// The agents' path, Diagnose to Deploy: a frame per step and the proof it leaves, the rail
// above them.
import Icon from "../../components/Icon.astro";
import Pointer from "../../components/Pointer.astro";
import { areaPath, linePath } from "../../lib/spark";
import { FIX, PATH, RISE } from "../../lib/story";
---

<section class="shot" data-shot="pipe">
  <ol class="rail">
    {PATH.map(({ step, yours }) => (
      <li data-rail class:list={[yours && "yours"]}><i></i><span>{step}</span></li>
    ))}
  </ol>
  <div class="viewport">
    <ol class="track" data-track>
      <li class="frame" data-frame>
        <p class="step mono">1 · Diagnose</p>
        <h3>Finds what broke, and says so plainly.</h3>
        <div class="panel" data-in>
          <p class="panel-head"><span>Route 5xx · /v4/orders</span><span class="mono faint">Grafana · last hour</span></p>
          <svg viewBox="0 0 1000 220" preserveAspectRatio="none" class="chart">
            <path d={areaPath(RISE, 1000, 220, 14)} class="area" data-area />
            <path d={linePath(RISE, 1000, 220, 14)} class="line" pathLength="1" data-draw />
            <line x1="820" x2="820" y1="0" y2="220" class="deploy" />
          </svg>
          <p class="panel-sub mono" data-in>api v1.35.11 deployed 4 min before the rise</p>
          <p class="diag" data-in><b>Diagnosis</b> /v4/orders parses an empty <code>region</code> as <code>0</code>, and the lookup throws. The change came in with v1.35.11.</p>
        </div>
      </li>
      <li class="frame" data-frame>
        <p class="step mono">2 · Fix</p>
        <h3>Changes the code, on its own branch.</h3>
        <div class="panel code" data-in>
          <p class="panel-head mono"><span>src/routes/orders.ts</span><span class="faint">fix-bt-api-empty-region · +4 −1</span></p>
          <pre>{FIX.map(([n, kind, text]) => (
            <span class:list={["dl", kind]} data-in><span class="ln">{n}</span>{text}{"\n"}</span>
          ))}</pre>
          <p class="panel-foot mono" data-in><span class="ok">✓</span> 214 pass · 0 fail</p>
        </div>
      </li>
      <li class="frame" data-frame>
        <p class="step mono">3 · Draft PR</p>
        <h3>Opens a draft, with the reasoning attached.</h3>
        <div class="panel" data-in>
          <p class="pr-title">fix(api): reject an empty region on /v4/orders <span class="faint">#3352</span></p>
          <p class="pr-meta"><span class="pill">Draft</span><span class="mono faint">fix-bt-api-empty-region</span></p>
          <div class="pr-body">
            <p data-in><b>Root cause.</b> An empty region was parsed as 0 since v1.35.11.</p>
            <p data-in><b>Fix.</b> Reject it with a 400 before the lookup.</p>
            <p data-in><b>Tested.</b> A unit test for the empty, missing and valid cases.</p>
          </div>
        </div>
      </li>
      <li class="frame" data-frame>
        <p class="step mono">4 · Second review</p>
        <h3>Another vendor’s model reads every diff.</h3>
        <div class="panel" data-in>
          <p class="panel-head"><span>Codex · read-only sandbox</span><span class="mono faint">Jev judges each finding</span></p>
          <ul class="rounds">
            <li data-in><span class="r mono">Round 1</span><span>A negative region still reaches the lookup.</span><span class="tag tag-amber">Blocking · 91%</span></li>
            <li data-in><span class="r"></span><span>Name the constant for the error message.</span><span class="tag">Dropped · nitpick</span></li>
            <li data-in><span class="r"></span><span>Agent: validates <code>region &gt; 0</code>, adds a test.</span><span class="tag">Fixed</span></li>
            <li data-in><span class="r mono">Round 2</span><span>No blocking findings.</span><span class="tag tag-green">Passed</span></li>
          </ul>
        </div>
      </li>
      <li class="frame" data-frame>
        <p class="step mono">5 · CI</p>
        <h3>Waits for green, and fixes what isn’t.</h3>
        <div class="panel" data-in>
          <p class="panel-head"><span>Out of draft · checks</span><span class="mono faint">#3352</span></p>
          <ul class="checks">
            <li data-check><span class="ok">✓</span> lint <span class="faint mono">18s</span></li>
            <li data-check><span class="ok">✓</span> typecheck <span class="faint mono">41s</span></li>
            <li data-check><span class="ok">✓</span> unit <span class="faint mono">1m 12s</span></li>
            <li data-check><span class="ok">✓</span> e2e · orders <span class="faint mono">3m 05s</span></li>
          </ul>
        </div>
      </li>
      <li class="frame" data-frame>
        <p class="step mono">6 · Review request</p>
        <h3>Asks a person to look.</h3>
        <div class="panel slack" data-in>
          <p class="slack-ch mono">#general-approvals</p>
          <div class="slack-msg" data-in>
            <span class="avatar">A</span>
            <div>
              <p><b>Alex</b> <span class="faint">via Bridgetown · 10:12</span></p>
              <p>🤖 <span class="link">PR #3352</span> is green and ready for review: reject an empty region on /v4/orders.</p>
              <p class="revv" data-in><Icon name="map" size={16} /> <span class="link">Revv walkthrough</span> <span class="faint">· 4 steps · 3 min</span></p>
            </div>
          </div>
        </div>
      </li>
      <li class="frame yours" data-frame>
        <p class="step mono"><i class="dot dot-amber"></i> 7 · Merge · Yours</p>
        <h3>You press Merge.</h3>
        <div class="panel" data-in>
          <div class="act">
            <span class="glyph green"><Icon name="git-merge" size={22} /></span>
            <span><b>Merge fix(api): reject an empty region</b><span class="faint">#3352 · Approved · CI green</span></span>
            <span class="primary" data-press>Merge</span>
          </div>
          <ul class="evidence" data-in>
            <li><span class="ok">✓</span> Approved by Julien</li>
            <li><span class="ok">✓</span> CI green · 4 checks</li>
            <li><span class="ok">✓</span> Second review passed</li>
          </ul>
          <Pointer size={28} class="pointer" data-pointer />
        </div>
      </li>
      <li class="frame yours" data-frame>
        <p class="step mono"><i class="dot dot-amber"></i> 8 · Release · Yours</p>
        <h3>You cut the release.</h3>
        <div class="panel" data-in>
          <div class="act">
            <span class="glyph"><Icon name="package" size={22} /></span>
            <span><b>Ship api v1.35.12</b><span class="faint">Merged · next version worked out for you</span></span>
            <span class="primary" data-press>Cut v1.35.12</span>
          </div>
          <ul class="evidence" data-in>
            <li><span class="faint">Next</span> v1.35.12</li>
            <li><span class="faint">Changes</span> 1 PR · #3352</li>
            <li><span class="faint">Tag</span> pushed by you, never an agent</li>
          </ul>
          <Pointer size={28} class="pointer" data-pointer />
        </div>
      </li>
      <li class="frame" data-frame>
        <p class="step mono">9 · Deploy</p>
        <h3>Follows it to production.</h3>
        <div class="panel" data-in>
          <ol class="tracker">
            <li data-check><i class="dot dot-done"></i> Approved <span class="faint mono">10:24</span></li>
            <li data-check><i class="dot dot-done"></i> Built <span class="faint mono">10:27</span></li>
            <li data-check class="prod"><i class="dot dot-green"></i> Deployed api v1.35.12 to production <span class="faint mono">10:31</span></li>
          </ol>
          <div class="slack-msg" data-in>
            <span class="avatar">A</span>
            <div>
              <p><b>Alex</b> <span class="faint">via Bridgetown · in the alert’s thread</span></p>
              <p>🤖 Deployed v1.35.12 ✓ 5xx on /v4/orders back to usual.</p>
            </div>
          </div>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .rail {
    position: absolute;
    top: 76px;
    left: 140px;
    right: 140px;
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    z-index: 2;
  }

  .rail li {
    display: grid;
    gap: 12px;
    font-size: 16px;
    color: var(--lo);
    transition: color 300ms;
  }

  .rail li i {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--hair);
    transition: background 300ms;
  }

  .rail li:global(.done) {
    color: var(--hi);
  }

  .rail li:global(.done) i {
    background: var(--hi);
  }

  .rail li.yours:global(.done) i {
    background: var(--amber);
  }

  .viewport {
    position: absolute;
    inset: 0;
  }

  .track {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    gap: 160px;
    margin: 0;
    padding: 0;
    list-style: none;
    will-change: transform;
  }

  .frame {
    flex: none;
    width: 1200px;
    padding-top: 250px;
  }

  .step {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 20px;
    color: var(--mid);
  }

  .frame h3 {
    margin: 14px 0 40px;
    font-size: 64px;
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--hi);
  }

  .panel {
    position: relative;
    padding: 34px 38px;
    border-radius: 26px;
    background: var(--card);
    box-shadow:
      inset 0 0 0 1px var(--hair),
      0 40px 120px rgb(0 0 0 / 0.6),
      0 0 160px oklch(0.63 0.19 252 / 0.06);
    font-size: 22px;
    color: var(--mid);
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    font-size: 19px;
    color: var(--hi);
    margin-bottom: 18px;
  }

  .chart {
    display: block;
    width: 100%;
    height: 220px;
  }

  .chart .area {
    fill: oklch(0.63 0.19 252 / 0.12);
  }

  .chart .line {
    fill: none;
    stroke: var(--hi);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .chart .deploy {
    stroke: var(--amber);
    stroke-dasharray: 4 6;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .panel-sub {
    margin-top: 14px;
    font-size: 17px;
    color: var(--amber);
  }

  .diag {
    margin-top: 18px;
    font-size: 24px;
    line-height: 1.45;
    color: var(--hi);
  }

  .diag b {
    margin-right: 8px;
    color: var(--mid);
    font-weight: 500;
  }

  code {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 1px 6px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.08);
  }

  .code pre {
    margin: 0;
    font-family: var(--mono);
    font-size: 21px;
    line-height: 1.75;
    color: var(--mid);
  }

  .dl {
    display: block;
    padding: 0 10px;
    border-radius: 6px;
  }

  .dl.add {
    color: #b9f0cf;
    background: oklch(0.62 0.12 158 / 0.14);
  }

  .dl.del {
    color: #ffc1b8;
    background: oklch(0.6 0.19 22 / 0.14);
  }

  .ln {
    display: inline-block;
    width: 44px;
    color: var(--lo);
  }

  .panel-foot {
    margin-top: 18px;
    font-size: 19px;
    color: var(--hi);
  }

  .pr-title {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--hi);
  }

  .pr-meta {
    display: flex;
    gap: 16px;
    align-items: center;
    margin: 14px 0 24px;
    font-size: 18px;
  }

  .pill {
    padding: 4px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--hair-strong);
    color: var(--hi);
    font-size: 17px;
  }

  .pr-body {
    display: grid;
    gap: 12px;
    padding-top: 22px;
    border-top: 1px solid var(--hair);
    font-size: 24px;
    color: var(--mid);
  }

  .pr-body b {
    color: var(--hi);
    font-weight: 560;
  }

  .rounds,
  .checks,
  .tracker {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rounds li {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 16px 0;
    border-top: 1px solid var(--hair);
    font-size: 23px;
    color: var(--hi);
  }

  .r {
    font-size: 17px;
    color: var(--lo);
  }

  .tag-amber {
    color: var(--amber);
    box-shadow: inset 0 0 0 1px oklch(0.8 0.15 74 / 0.5);
  }

  .tag-green {
    color: var(--green);
    box-shadow: inset 0 0 0 1px oklch(0.62 0.12 158 / 0.5);
  }

  .checks li,
  .tracker li {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 0;
    border-top: 1px solid var(--hair);
    font-size: 28px;
    color: var(--hi);
  }

  .checks li .faint,
  .tracker li .faint {
    margin-left: auto;
    font-size: 19px;
  }

  .tracker li.prod {
    font-weight: 560;
  }

  .slack-ch {
    font-size: 18px;
    color: var(--lo);
    margin-bottom: 18px;
  }

  .link {
    color: oklch(0.74 0.14 252);
  }

  .revv {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    padding: 12px 16px;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--hair);
    width: max-content;
  }

  .act {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: 22px;
    align-items: center;
  }

  .act b {
    display: block;
    font-size: 28px;
    font-weight: 560;
    letter-spacing: -0.015em;
    color: var(--hi);
  }

  .act .faint {
    font-size: 20px;
  }

  .evidence {
    display: flex;
    gap: 14px;
    margin: 30px 0 0;
    padding: 26px 0 0;
    list-style: none;
    border-top: 1px solid var(--hair);
  }

  .evidence li {
    padding: 10px 18px;
    border-radius: 12px;
    box-shadow: inset 0 0 0 1px var(--hair);
    font-size: 20px;
    color: var(--hi);
  }

  .glyph {
    display: grid;
    place-content: center;
    width: 60px;
    height: 60px;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px var(--hair-strong);
    color: var(--hi);
  }

  .glyph.green {
    color: var(--green);
  }
</style>
