---
// Calibration: verdicts kept with their numbers, and a thumb for each.
import Icon from "../../components/Icon.astro";
import Pointer from "../../components/Pointer.astro";

const verdicts = [
  { from: "#alert-api", who: "Monitor", text: "5xx rate 3.1% on /v4/orders over 5 minutes", route: ["Agent started", "blue"], nums: "actionable 93% · agent 86%" },
  { from: "#alert-jobs", who: "Monitor", text: "cron rewards-sync exceeded 15 min", route: ["Suggested to you", "amber"], nums: "actionable 61% · agent 72%" },
  { from: "#eng-infra", who: "Julien", text: "is the Base indexer behind again?", route: ["Needs you", "amber"], nums: "needs you 84% · agent 9%" },
] as const;
---

<section class="shot" data-shot="calibrate">
  <div class="cam calibrate">
    <div class="team-copy">
      <h2 class="hl-m">Tell it when <span class="dim">it’s wrong.</span></h2>
      <p class="sub">Every verdict is kept with its numbers. A thumb labels it for calibration.</p>
    </div>
    <ol class="verdicts">
      {
        verdicts.map((v) => (
          <li class="v-row" data-vrow>
            <p class="t-meta"><span class="mono">{v.from}</span><span>{v.who}</span></p>
            <p class="v-text">{v.text}</p>
            <p class="v-route"><i class={`dot dot-${v.route[1]}`} /> {v.route[0]} <span class="faint mono">{v.nums}</span></p>
            <div class="v-fb">
              <span class="v-q" data-vq>Was this the right call?</span>
              <span class="thumb" data-thumb><Icon name="thumbs-up" size={24} /></span>
              <span class="thumb" data-thumb><Icon name="thumbs-down" size={24} /></span>
            </div>
          </li>
        ))
      }
    </ol>
    <Pointer size={34} class="pointer big" data-pointer />
  </div>
</section>

<style>
  .calibrate {
    display: grid;
    grid-template-columns: 700px 900px;
    gap: 120px;
    justify-content: center;
    align-content: center;
    align-items: center;
  }

  .verdicts {
    margin: 0;
    padding: 14px 44px;
    list-style: none;
    border-radius: 28px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--hair);
  }

  .v-row {
    display: grid;
    gap: 10px;
    padding: 30px 0;
  }

  .v-row + .v-row {
    border-top: 1px solid var(--hair);
  }

  .v-text {
    font-size: 28px;
    letter-spacing: -0.015em;
    color: var(--hi);
  }

  .v-route {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    color: var(--mid);
  }

  .v-route .mono {
    margin-left: 6px;
    font-size: 17px;
  }

  .v-fb {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font-size: 19px;
  }

  .v-q {
    margin-right: auto;
    color: var(--lo);
  }

  .thumb {
    display: grid;
    place-items: center;
    width: 48px;
    height: 42px;
    border-radius: 10px;
    color: var(--mid);
  }

  .thumb:global(.picked) {
    color: var(--hi);
    background: rgb(255 255 255 / 0.08);
  }

  .thumb:global(.picked) :global(svg) {
    fill: currentColor;
  }
</style>
