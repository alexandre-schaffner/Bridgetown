---
// It asks and you answer; it drafts and you send.
import Pointer from "../../components/Pointer.astro";
---

<section class="shot" data-shot="ask">
  <div class="cam ask">
    <div class="ask-col">
      <h2 class="hl-s">It asks. <span class="dim">You answer.</span></h2>
      <div class="card" data-acard>
        <p class="c-meta"><i class="dot dot-blue live"></i> fix(api): empty region · Fix <span class="faint mono">Opus · high</span></p>
        <p class="c-q">Negative regions return 400 too, or should they fall back to the default region?</p>
        <div class="c-replies">
          <span class="chip" data-chip>Return 400</span>
          <span class="chip" data-chip>Fall back</span>
        </div>
        <p class="c-after" data-after><i class="dot dot-blue live"></i> Answered. The agent carries on.</p>
      </div>
    </div>
    <div class="ask-col">
      <h2 class="hl-s">It drafts. <span class="dim">You send.</span></h2>
      <div class="card" data-rcard>
        <p class="c-meta"><span class="mono">#eng-api</span> Jonas <span class="faint">· 10:02</span></p>
        <p class="c-q">@alex the orders page 500s when region is empty, can you take a look?</p>
        <div class="draft">
          <p class="d-label mono">Draft · from the agent</p>
          <p class="d-text" data-type="Found it: an empty region was parsed as 0 since v1.35.11. Fix is in #3352, green and up for review."></p>
        </div>
        <div class="c-replies end"><span class="chip">Edit</span><span class="chip primary" data-chip>Send reply</span></div>
        <p class="c-after" data-after><i class="dot dot-done"></i> Sent in the thread, as you.</p>
      </div>
    </div>
    <Pointer size={34} class="pointer big" data-pointer />
  </div>
</section>

<style>
  .ask {
    display: grid;
    grid-template-columns: 760px 760px;
    gap: 80px;
    justify-content: center;
    align-content: center;
  }

  .ask-col {
    display: grid;
    gap: 44px;
    align-content: start;
  }

  .card {
    position: relative;
    padding: 34px 36px;
    border-radius: 26px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--hair);
    min-height: 470px;
  }

  .c-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 19px;
    color: var(--mid);
  }

  .c-meta .faint {
    margin-left: auto;
  }

  .c-q {
    margin-top: 20px;
    font-size: 30px;
    line-height: 1.32;
    letter-spacing: -0.02em;
    color: var(--hi);
  }

  .c-replies {
    display: flex;
    gap: 14px;
    margin-top: 30px;
  }

  .c-replies.end {
    justify-content: flex-end;
  }

  .chip {
    padding: 12px 24px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--hair-strong);
    font-size: 22px;
    color: var(--hi);
  }

  .chip.primary {
    padding: 12px 26px;
    font-size: 22px;
  }

  .chip:global(.picked) {
    background: #fff;
    color: #000;
  }

  .c-after {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: 30px;
    font-size: 21px;
    color: var(--mid);
    opacity: 0;
  }

  .draft {
    margin-top: 24px;
    padding: 20px 22px;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px var(--hair);
    background: rgb(255 255 255 / 0.03);
  }

  .d-label {
    font-size: 16px;
    color: var(--lo);
  }

  .d-text {
    margin-top: 8px;
    min-height: 3.9em;
    font-size: 23px;
    line-height: 1.4;
    color: var(--hi);
  }
</style>
