---
// Settings → Models, the real window (src/assets/app/settings-models.png): who investigates and
// who reviews, each chosen on its own. launch.ts lights one group, then the other.
import models from "../../assets/app/settings-models.png";
---

<section class="shot models" data-shot="models">
  <div class="copy">
    <p class="kick mono">Your models</p>
    <h2 class="hl-m">Choose your investigator <span class="dim">and your reviewer.</span></h2>
    <p class="sub">Claude Code or Codex, any model, any effort. One investigates and fixes; the other reviews the fix before the pull request leaves draft.</p>
  </div>
  <div class="cam">
    <figure class="panel" data-panel>
      <img src={models.src} alt="" />
      <div class="spot" data-spot></div>
    </figure>
  </div>
</section>

<style>
  .copy {
    position: absolute;
    left: 160px;
    top: 50%;
    width: 760px;
    translate: 0 -50%;
    display: grid;
    gap: 30px;
  }

  .sub {
    max-width: 640px;
  }

  /* 960 × 1258 at two thirds: 640 × 839. */
  .panel {
    position: absolute;
    right: 170px;
    top: 120px;
    width: 640px;
    height: 839px;
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--hair-strong),
      0 80px 160px -40px rgb(0 0 0 / 0.9);
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .spot {
    position: absolute;
    border-radius: 12px;
    box-shadow:
      0 0 0 1.5px rgb(255 255 255 / 0.3),
      0 0 0 3000px rgb(0 0 0 / 0.6);
    opacity: 0;
  }
</style>
