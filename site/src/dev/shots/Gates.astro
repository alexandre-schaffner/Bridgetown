---
// The three clicks that stay yours.
import Pointer from "../../components/Pointer.astro";
---

<section class="shot" data-shot="gates">
  <div class="cam gates">
    <h2 class="hl-m">Three clicks stay yours.</h2>
    <div class="g-row">
      <div class="g" data-gate>
        <p class="g-kind"><i class="dot dot-amber"></i> Needs you</p>
        <span class="g-btn" data-press>Merge</span>
        <p class="g-d">Approved, green, waiting.</p>
      </div>
      <div class="g" data-gate>
        <p class="g-kind"><i class="dot dot-amber"></i> Needs you</p>
        <span class="g-btn" data-press>Cut release</span>
        <p class="g-d">Tags are never pushed by an agent.</p>
      </div>
      <div class="g" data-gate>
        <p class="g-kind"><i class="dot dot-amber"></i> Needs you</p>
        <span class="g-btn" data-press>Send reply</span>
        <p class="g-d">Nothing goes to a teammate unsent.</p>
      </div>
    </div>
    <p class="g-foot">Everything else, the agents carry.</p>
    <Pointer size={34} class="pointer big" data-pointer />
  </div>
</section>

<style>
  .gates {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 90px;
  }

  .g-row {
    display: grid;
    grid-template-columns: repeat(3, 480px);
    gap: 40px;
  }

  .g {
    display: grid;
    justify-items: center;
    gap: 26px;
    padding: 50px 30px 44px;
    border-radius: 30px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--hair);
    text-align: center;
  }

  .g-kind {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 19px;
    color: var(--amber);
  }

  .g-btn {
    padding: 22px 54px;
    font-size: 40px;
    letter-spacing: -0.025em;
  }

  .g-d {
    font-size: 21px;
    color: var(--lo);
  }

  .g-foot {
    font-size: 40px;
    font-weight: 560;
    letter-spacing: -0.03em;
    color: var(--mid);
  }
</style>
