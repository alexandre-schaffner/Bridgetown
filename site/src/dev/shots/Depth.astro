---
// Depth picks the model; this is the only table that names one.

const depths = [
  { depth: "quick", model: "Sonnet", effort: "medium", fill: 0.34, example: "A flaky check, a typo in a config" },
  { depth: "standard", model: "Opus", effort: "high", fill: 0.67, example: "A 5xx on one route, a failing job" },
  { depth: "deep", model: "Opus", effort: "max", fill: 1, example: "A regression across services" },
];
---

<section class="shot" data-shot="depth">
  <div class="cam depth">
    <h2 class="hl-m">Depth picks the model.</h2>
    <div class="d-grid">
      {
        depths.map((d) => (
          <div class="d-card" data-dcard>
            <p class="d-depth mono">{d.depth}</p>
            <p class="d-model">{d.model}</p>
            <p class="d-effort">{d.effort} effort</p>
            <span class="d-meter"><i style={`--f:${d.fill}`} /></span>
            <p class="d-ex">{d.example}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .depth {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 80px;
  }

  .d-grid {
    display: grid;
    grid-template-columns: repeat(3, 460px);
    gap: 32px;
  }

  .d-card {
    padding: 40px;
    border-radius: 28px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--hair);
  }

  .d-depth {
    font-size: 20px;
    color: var(--mid);
  }

  .d-model {
    margin-top: 28px;
    font-size: 76px;
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--hi);
  }

  .d-effort {
    margin-top: 8px;
    font-size: 26px;
    color: var(--mid);
  }

  .d-meter {
    display: block;
    margin: 34px 0 24px;
    height: 6px;
    border-radius: 3px;
    background: var(--hair);
    overflow: hidden;
  }

  .d-meter i {
    display: block;
    height: 100%;
    width: calc(var(--f) * 100%);
    background: var(--hi);
    transform-origin: 0 50%;
  }

  .d-ex {
    font-size: 19px;
    color: var(--lo);
  }
</style>
