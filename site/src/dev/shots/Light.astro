---
// The light, over the arch, in its four states.

const lights = [
  ["rest", "Cool white", "Nothing is waiting on you."],
  ["working", "Blue lamps", "Agents are at work."],
  ["needs-you", "Amber", "A decision is yours."],
  ["paused", "Dim", "Paused. Alerts are still read."],
];
---

<section class="shot over corner" data-shot="light">
  <h2 class="light-title">Read the light.</h2>
  <p class="light-sub">The arch on your Dock burns the same colour.</p>
  <ul class="light-states">
    {lights.map(([key, name, text]) => (
      <li data-lstate={key}><i class={`lamp lamp-${key}`}></i><b>{name}</b><span>{text}</span></li>
    ))}
  </ul>
</section>

<style>
  .light-title {
    font-size: 120px;
    font-weight: 620;
    letter-spacing: -0.048em;
    color: var(--hi);
  }

  .light-sub {
    margin-top: 18px;
    font-size: 30px;
    color: var(--mid);
  }

  .light-states {
    position: fixed;
    left: 120px;
    right: 120px;
    bottom: 90px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .light-states li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 6px 16px;
    align-items: center;
    opacity: 0.25;
    transition: opacity 400ms;
  }

  .light-states li:global(.on) {
    opacity: 1;
  }

  .light-states b {
    font-size: 24px;
    font-weight: 560;
    color: var(--hi);
  }

  .light-states span {
    grid-column: 2;
    font-size: 19px;
    color: var(--mid);
  }

  .lamp {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #e8eefc;
    box-shadow: 0 0 14px #cfe0ff;
  }

  .lamp-working {
    background: var(--blue);
    box-shadow: 0 0 14px var(--blue);
  }

  .lamp-needs-you {
    background: var(--amber);
    box-shadow: 0 0 14px var(--amber);
  }

  .lamp-paused {
    background: #3a3a3c;
    box-shadow: none;
  }
</style>
