---
// When it can't see, it says so: the header's strip, a dot per service.
import { SERVICES } from "../../lib/story";
---

<section class="shot" data-shot="health">
  <div class="cam health">
    <h2 class="hl-m">When it can’t see, <span class="dim">it says so.</span></h2>
    <div class="h-card" data-hcard>
      <p class="h-strip">
        {SERVICES.map((s) => <span class="h-svc" data-svc={s}><i class="dot dot-done" />{s}</span>)}
        <span class="faint mono h-poll">polled 12s ago</span>
      </p>
      <div class="h-fold" data-hfold>
        <p class="h-problem"><i class="dot dot-amber" /> <span class="mono" data-type="grafana MCP · sessions: not reachable. Run `bun grafana:mcp` in the monorepo."></span></p>
        <p class="h-problem h-after" data-hafter><i class="dot dot-done" /> Grafana is back. The warning clears itself.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .health {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 70px;
  }

  .h-card {
    width: 1360px;
    padding: 40px 50px;
    border-radius: 28px;
    background: var(--card);
    box-shadow: inset 0 0 0 1px var(--hair);
  }

  .h-strip {
    display: flex;
    align-items: center;
    gap: 40px;
    font-size: 30px;
    color: var(--mid);
  }

  .h-svc {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .h-poll {
    margin-left: auto;
    font-size: 20px;
  }

  .h-fold {
    position: relative;
    height: 0;
    overflow: hidden;
  }

  .h-problem {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 26px;
    padding-top: 26px;
    border-top: 1px solid var(--hair);
    font-size: 25px;
    color: var(--hi);
  }

  .h-problem.h-after {
    position: absolute;
    inset: 0 0 auto;
    color: var(--mid);
    opacity: 0;
  }
</style>
