---
// A chapter's card: its number and name, and the line that opens it (the slot).
interface Props {
  shot: string;
  kick: string;
}
const { shot, kick } = Astro.props;
---

<section class="shot center chapter" data-shot={shot}>
  <p class="kick mono">{kick}</p>
  <h2 class="hl"><slot /></h2>
</section>
