---
// Settings → Behaviour, as the app has it.
import Icon from "../../components/Icon.astro";
import Pointer from "../../components/Pointer.astro";

const toggles = [
  { label: "Start agents automatically", on: true },
  { label: "Adversarial review", on: true, note: "Codex reviews every fix before the PR leaves draft." },
  { label: "Watch prod", on: true, note: "Signals every 5 minutes, logs every 10." },
  { label: "Watch my mentions & DMs everywhere", on: true },
  { label: "Quiet hours", on: false, flip: "No notifications during quiet hours. Auto-start keeps running." },
  { label: "Dry run", on: false, flip: "Agents still run, but nothing is posted to Slack." },
  { label: "Launch at login", on: true },
];
---

<section class="shot" data-shot="settings">
  <div class="cam settings">
    <div class="team-copy">
      <h2 class="hl-m">Yours to tune.</h2>
      <p class="sub">Thresholds, quiet hours, a dry run. Tokens stay in your Keychain.</p>
    </div>
    <div class="win" data-win>
      <ol class="win-tabs">
        {[["key", "Accounts"], ["hash", "Channels"], ["git-branch", "Repos"], ["sliders-horizontal", "Triage"], ["settings-2", "Behaviour"]].map(([icon, name]) => (
          <li class:list={[name === "Behaviour" && "on"]}><Icon name={icon!} size={24} /><span>{name}</span></li>
        ))}
      </ol>
      <ul class="toggles">
        {toggles.map((t) => (
          <li data-toggle data-flip={t.flip ? "" : undefined}>
            <div>
              <p>{t.label}</p>
              {t.note && <p class="tg-note">{t.note}</p>}
              {t.flip && <p class="tg-note tg-flip" data-flipnote>{t.flip}</p>}
            </div>
            <span class:list={["switch", t.on && "on"]} data-switch><b></b></span>
          </li>
        ))}
      </ul>
    </div>
    <Pointer size={34} class="pointer big" data-pointer />
  </div>
</section>

<style>
  .settings {
    display: grid;
    grid-template-columns: 640px 900px;
    gap: 110px;
    justify-content: center;
    align-content: center;
    align-items: center;
  }

  .win {
    border-radius: 26px;
    background: #111113;
    box-shadow:
      inset 0 0 0 1px var(--hair-strong),
      0 60px 140px rgb(0 0 0 / 0.8);
    overflow: hidden;
  }

  .win-tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 0;
    padding: 20px 20px 16px;
    list-style: none;
    border-bottom: 1px solid var(--hair);
  }

  .win-tabs li {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 120px;
    padding: 10px 0 8px;
    border-radius: 12px;
    font-size: 15px;
    color: var(--lo);
  }

  .win-tabs li.on {
    background: rgb(255 255 255 / 0.08);
    color: var(--hi);
  }

  .toggles {
    margin: 0;
    padding: 10px 44px 20px;
    list-style: none;
  }

  .toggles li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    padding: 18px 0;
    font-size: 25px;
    color: var(--hi);
  }

  .toggles li + li {
    border-top: 1px solid var(--hair);
  }

  .tg-note {
    margin-top: 4px;
    font-size: 18px;
    color: var(--lo);
  }

  .tg-flip {
    height: 0;
    overflow: hidden;
    margin-top: 0;
    opacity: 0;
  }

  .switch {
    position: relative;
    flex: none;
    width: 64px;
    height: 38px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
  }

  .switch b {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.4);
  }

  .switch.on {
    background: var(--hi);
  }

  .switch.on b {
    left: 29px;
    background: #000;
    box-shadow: none;
  }
</style>
