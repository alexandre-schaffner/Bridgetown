---
// The montage, a word a beat, and the end card.
import ArchMark from "../../components/ArchMark.astro";

const montage = ["Triage.", "Fix.", "Review.", "Ship."];
---

<section class="shot center" data-shot="montage">
  {montage.map((w) => <p class="m-word" data-mword>{w}</p>)}
</section>

<section class="shot over high end" data-shot="end">
  <p class="mark"><ArchMark size={48} /></p>
  <h2 class="name sm">Bridgetown</h2>
  <p class="end-line">From Slack alert to reviewed fix. <span class="dim">Right in your Mac’s notch.</span></p>
  <p class="end-small mono">Download for macOS · Apple silicon · macOS 14 or later</p>
</section>

<style>
  .name.sm {
    font-size: 150px;
  }

  .m-word {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    font-size: 240px;
    font-weight: 640;
    letter-spacing: -0.055em;
    color: var(--hi);
    opacity: 0;
  }

  .end-line {
    margin-top: 6px;
    font-size: 40px;
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--hi);
  }

  .end-small {
    margin-top: 8px;
    font-size: 21px;
    color: var(--mid);
    text-shadow: 0 2px 18px #000;
  }
</style>
