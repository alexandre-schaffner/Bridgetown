---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Recording from "../components/Recording.astro";
import Notch from "../components/Notch.astro";
import Film from "../components/Film.astro";
import Triage from "../components/Triage.astro";
import Journey from "../components/Journey.astro";
import Outcomes from "../components/Outcomes.astro";
import Watch from "../components/Watch.astro";
import Safety from "../components/Safety.astro";
import Finale from "../components/Finale.astro";
import { site } from "../site";

const title = "Bridgetown: your alerts, handled before you look";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#050608" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Script on, and the theme resolved before the first paint so nothing flashes.
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let choice = "light";
        try {
          choice = localStorage.getItem("bridgetown-theme") || "light";
        } catch {}
        const dark = choice === "dark" || (choice === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
        root.classList.toggle("theme-dark", dark);
        root.dataset.theme = choice;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />

    <div class="scene" aria-hidden="true">
      <!-- The live arch, for the closing chapter (scripts/scene.ts). -->
      <canvas data-scene></canvas>
      <!-- The hero's dawn: one shader (scripts/dawn.ts). Without WebGL, a still glow stands in
           and the flood to day is a plain gradient. -->
      <div class="hero-media" data-hero-media>
        <canvas data-dawn></canvas>
        <div class="flood"></div>
      </div>
    </div>

    <main id="main">
      <Hero />
      <Recording />
      <Notch />
      <Triage />
      <Journey />
      <Outcomes />
      <Watch />
      <Safety />
      <Finale />
    </main>

    <Film />

    <script>
      import "../scripts/main";
    </script>
  </body>
</html>

<style>
  /* The arch's stage, behind everything. Night sections are see-through; day covers it. */
  .scene {
    position: fixed;
    inset: 0;
    z-index: var(--z-scene);
    background: #050608;
  }

  canvas[data-scene] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }

  :global(.scene-ready) canvas[data-scene] {
    opacity: 1;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(130% 55% at 50% 112%, oklch(0.55 0.09 255 / 0.45), oklch(0.3 0.06 255 / 0.15) 55%, transparent 75%),
      #050608;
    transition: opacity 300ms linear;
  }

  :global(.hero-away) .hero-media {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 300ms linear,
      visibility 0s 300ms;
  }

  canvas[data-dawn] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms linear;
  }

  :global(.dawn-ready) canvas[data-dawn] {
    opacity: 1;
  }

  /* The flood to day without the shader. */
  .flood {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 90%,
      var(--day) calc(var(--reach, 0) * 1% - 30%),
      transparent calc(var(--reach, 0) * 1% + 25%)
    );
    opacity: var(--flood, 0);
  }

  /* Nothing in a chapter may widen the page: a sideways nudge on a trackpad would pan it. */
  main {
    position: relative;
    overflow-x: clip;
  }
</style>
