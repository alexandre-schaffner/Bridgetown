---
// One of the real app's screens: src/assets/app/, captured at 2× from the running app with
// demo data (scripts/showcase-screenshots.sh), so what the page shows is what Bridgetown
// draws. Every screen is the open island, 1100 by 512 points, and every use draws it at about
// that width, so one pair of sizes serves them all. `crop` shows part of it, in the image's
// own pixels. Without one, a parent can set --ratio and --focus to fit it into another shape,
// as object-fit does. `edge` draws the app's hairline around it, rounded like the island.
// `narrow` is what a phone shows instead, in its own shape: a phone fetches only that one.
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { getImage } from "astro:assets";

type Props = Omit<HTMLAttributes<"div">, "style"> & {
  src: ImageMetadata;
  alt: string;
  crop?: { x: number; y: number; width: number; height: number };
  edge?: boolean;
  loading?: "eager" | "lazy";
  narrow?: ImageMetadata;
};
const { src, alt, crop, edge = false, loading = "lazy", narrow, class: className, ...attributes } = Astro.props;

/** Where `narrow` takes over; the same width as the style's below. */
const NARROW = "(max-width: 600px)";
const formats = ["avif", "webp"] as const;
const sizesOf = async (image: ImageMetadata, widths: number[], sizes: string, media?: string) =>
  Promise.all(
    formats.map(async (format) => ({ format, media, sizes, result: await getImage({ src: image, widths, sizes, format }) })),
  );
const sources = [
  ...(narrow ? await sizesOf(narrow, [narrow.width / 2, narrow.width], "100vw", NARROW) : []),
  ...(await sizesOf(src, [1100, 2200], "1100px")),
];
const fallback = sources.at(-1)!.result;

const box = crop ?? { x: 0, y: 0, width: src.width, height: src.height };
const pct = (v: number) => `${(v * 100).toFixed(4)}%`;
const geometry = {
  "--natural": `${box.width} / ${box.height}`,
  ...(crop && {
    "--crop-w": pct(src.width / crop.width),
    "--crop-x": pct(-crop.x / crop.width),
    "--crop-y": pct(-crop.y / crop.height),
  }),
  ...(narrow && { "--natural-narrow": `${narrow.width} / ${narrow.height}` }),
};
---

<div class:list={["app-shot", crop && "cropped", edge && "edge", narrow && "has-narrow", className]} style={geometry} {...attributes}>
  <picture>
    {
      sources.map(({ format, media, sizes, result }) => (
        <source srcset={result.srcSet.attribute} type={`image/${format}`} media={media} sizes={sizes} />
      ))
    }
    <img
      src={fallback.src}
      srcset={fallback.srcSet.attribute}
      sizes="1100px"
      width={src.width / 2}
      height={src.height / 2}
      alt={alt}
      loading={loading}
      decoding="async"
      draggable="false"
    />
  </picture>
</div>

<style>
  .app-shot {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--ratio, var(--natural));
    background: #000;
  }

  @media (max-width: 600px) {
    .has-narrow {
      aspect-ratio: var(--ratio, var(--natural-narrow));
    }
  }

  .app-shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, 50% 0);
    user-select: none;
  }

  .cropped :global(img) {
    position: absolute;
    left: var(--crop-x);
    top: var(--crop-y);
    width: var(--crop-w);
    max-width: none;
    height: auto;
  }

  /* The island's bottom corners: 32 points of its 1100 by 512, the same share of the whole
     screen at any size. A parent that fits it into another shape sets --radius. */
  .edge {
    border-radius: var(--radius, 2.909% / 6.25%);
  }

  .edge::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--ui-hairline);
    pointer-events: none;
  }
</style>
