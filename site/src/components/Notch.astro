---
// Day. On the other side of the arch: the top of a MacBook, and Bridgetown living in its
// notch. Pinned while the island plays through its states (scripts/island.ts): wings, a
// banner, the whole app, a session opened and merged, folded away. Each step's title picks it.
// The page made for a phone (.phone) doesn't pin it: the steps play in time, one after another
// while the screen is in view, like stories, and a tap picks one.
import MacScreen from "./MacScreen.astro";

const steps = [
  {
    id: "wings",
    title: "Wings",
    text: "Either side of the notch: the arch glows blue while agents work, and the count says what waits on you.",
  },
  {
    id: "banner",
    title: "A banner",
    text: "When something becomes yours, it drops out of the notch for a few seconds, then tucks back in.",
  },
  {
    id: "open",
    title: "The whole app",
    text: "Click, and Bridgetown unfolds underneath: prod, what needs you, what the agents are doing.",
  },
  {
    id: "merge",
    title: "One click",
    text: "Settle it there: merge, cut the release, send the reply. Then it folds away.",
  },
];
---

<section class="notch day" id="notch" data-sheet data-notch aria-labelledby="notch-title">
  <div class="pin">
    <MacScreen />

    <div class="copy">
      <h2 id="notch-title" class="display">It lives in the notch.</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li data-step={s.id} class:list={[i === 0 && "on"]}>
              <button class="s-title" type="button" data-step-pick>
                {s.title}
              </button>
              <span class="s-text">{s.text}</span>
            </li>
          ))
        }
      </ol>
      <p class="try" hidden data-try>
        <span class="pointer">Your turn: hover the notch, click it open, and merge what's ready to ship.</span>
        <span class="touch">Your turn: tap the notch open, and merge what's ready to ship.</span>
      </p>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { $, $$ } from "../lib/dom";
  import { clamp } from "../lib/math";
  import { createIsland } from "../scripts/island";
  import { lenis, phone, reduced, ScrollTrigger } from "../scripts/scroll";

  const notch = $("[data-notch]");
  if (notch) {
    const island = createIsland(notch, { reducedMotion: reduced });
    const tryIt = $("[data-try]", notch);
    if (tryIt) tryIt.hidden = false;
    const steps = $$("[data-step]", notch);
    const picks = $$<HTMLButtonElement>("[data-step-pick]", notch);

    if (phone) {
      // How long each step plays, in ms: long enough for its whole script (scripts/island.ts)
      // and a moment to read what it left.
      const LENGTHS = [2800, 3800, 4200, 5400];
      let at = 0;
      let elapsed = 0;
      let last = 0;
      let raf = 0;
      let inView = false;
      // Once through, or once you take the island yourself, it waits for a tap.
      let finished = false;
      const show = (i: number) => {
        at = i;
        elapsed = 0;
        island.setStep(i);
        steps.forEach((el, j) => el.style.setProperty("--fill", j < i ? "1" : "0"));
      };
      const frame = (now: number) => {
        raf = 0;
        if (!inView || finished) return;
        elapsed += now - last;
        last = now;
        const v = clamp(elapsed / LENGTHS[at]!);
        steps[at]!.style.setProperty("--fill", (reduced ? 1 : v).toFixed(3));
        if (v >= 1) {
          if (at === steps.length - 1) {
            finished = true;
            return;
          }
          show(at + 1);
        }
        raf = requestAnimationFrame(frame);
      };
      const run = () => {
        if (raf || !inView || finished) return;
        last = performance.now();
        raf = requestAnimationFrame(frame);
      };
      new IntersectionObserver(
        ([e]) => {
          inView = e!.isIntersecting;
          island.setVisible(inView);
          run();
        },
        { threshold: 0.4 },
      ).observe($("[data-mac]", notch)!);
      picks.forEach((b, i) =>
        b.addEventListener("click", () => {
          finished = false;
          show(i);
          run();
        }),
      );
      for (const hit of $$("[data-island-hit], [data-target='merge']", notch)) {
        hit.addEventListener("click", () => (finished = true));
      }
      show(0);
    } else {
      const cuts = [0, 0.22, 0.46, 0.7, 1];
      // Pinning starts at "top top"; the first stretch before it is the approach.
      const pinStart = () => innerHeight * 0.6;
      const total = () => notch.offsetHeight - 2 * innerHeight + pinStart();
      const trigger = ScrollTrigger.create({
        trigger: notch,
        start: "top 60%",
        // The last screen of the pin is the next chapter sliding over it.
        end: () => `bottom-=${innerHeight} bottom`,
        onToggle: (s) => island.setVisible(s.isActive),
        onUpdate: (s) => {
          const p = clamp((s.progress * total() - pinStart()) / (total() - pinStart()));
          const step = cuts.findIndex((c, i) => p >= c && p < (cuts[i + 1] ?? 2));
          island.setStep(Math.max(0, step));
          steps.forEach((el, i) => el.style.setProperty("--fill", clamp((p - cuts[i]!) / (cuts[i + 1]! - cuts[i]!)).toFixed(3)));
        },
      });
      island.setVisible(true);
      // A step's title scrolls to it, a little way into its stretch.
      picks.forEach((b, i) =>
        b.addEventListener("click", () => {
          const progress = ((cuts[i]! + 0.02) * (total() - pinStart()) + pinStart()) / total();
          const y = trigger.start + progress * (trigger.end - trigger.start);
          if (lenis) lenis.scrollTo(y, { duration: 1.1, easing: (t) => 1 - (1 - t) ** 4 });
          else scrollTo(0, y);
        }),
      );
    }

    // The machine rises into place as the day arrives.
    if (!reduced && !phone) {
      gsap.fromTo(
        $("[data-mac]", notch),
        { y: 120, scale: 0.9, rotateX: 22, transformPerspective: 1400, transformOrigin: "50% 0%", opacity: 0.4 },
        {
          y: 0,
          scale: 1,
          rotateX: 0,
          opacity: 1,
          ease: "none",
          scrollTrigger: { trigger: notch, start: "top bottom", end: "top top", scrub: true },
        },
      );
    }
  }
</script>

<style>
  .notch {
    padding-block: 5rem 4rem;
  }

  .pin {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3vh, 2.5rem);
  }

  .copy {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: 1.25rem 4rem;
    align-items: start;
    width: min(100% - 2 * var(--gutter), 92rem);
    margin-inline: auto;
  }

  .copy .display {
    font-size: clamp(2.25rem, 2.6vw + 1rem, 3.75rem);
    max-width: 9ch;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    position: relative;
    display: grid;
    gap: 0.375rem;
    align-content: start;
    padding-top: 1rem;
    font-size: var(--t-small);
    line-height: 1.5;
  }

  /* Each step's line fills while it is the one playing. */
  .steps li::before,
  .steps li::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 1px;
    background: var(--line);
  }

  .steps li::after {
    background: var(--ink);
    transform-origin: 0 50%;
    transform: scaleX(var(--fill, 1));
  }

  :global(html.js) .steps li::after {
    transform: scaleX(var(--fill, 0));
  }

  .s-title {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 560;
    text-align: left;
    cursor: pointer;
  }

  .s-text {
    color: var(--ink-dim);
  }

  .try {
    grid-column: 2;
    font-size: var(--t-small);
    color: var(--ink-faint);
  }

  :global(html.js) .steps li {
    transition: opacity 400ms var(--ease-out);
    opacity: 0.45;
  }

  :global(html.js) .steps li.on {
    opacity: 1;
  }

  /* With script: one viewport, pinned, while the island plays. It slides in over the
     recording, and the next chapter slides over its own last 100svh (scripts/main.ts). */
  :global(html.js) .notch {
    height: 620svh;
    margin-top: -100svh;
    padding: 0;
  }

  /* The machine's row gives up height before the words do: on a short phone (320x568) they
     would run out of the pin's foot. */
  :global(html.js) .pin {
    position: sticky;
    top: 0;
    height: 100svh;
    grid-template-rows: minmax(0, auto) auto;
    align-content: safe center;
    padding-top: 3.5rem;
    overflow: hidden;
  }

  .touch {
    display: none;
  }

  @media (hover: none) {
    .pointer {
      display: none;
    }
    .touch {
      display: inline;
    }
  }

  @media (max-width: 900px) {
    .copy {
      grid-template-columns: 1fr;
    }
    .try {
      grid-column: 1;
    }
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* A phone sideways: the words beside each other again, and the pin's whole height for the
     screen. The nav steps aside while you read down, so it needs no room kept. */
  @media (max-height: 560px) and (orientation: landscape) {
    .copy {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    }
    .try {
      grid-column: 2;
    }
    :global(html.js) .pin {
      padding-top: 0;
    }
  }

  /* A phone, pinned: the four steps in a row, and only the playing one's words beneath, which
     keep clear of the screen's foot. */
  @media (max-width: 600px), (max-height: 560px) and (orientation: landscape) {
    :global(html.js) .pin {
      padding-bottom: 1rem;
    }
    :global(html.js) .steps {
      position: relative;
      grid-template-columns: repeat(4, auto);
      justify-content: space-between;
      gap: 0.5rem;
      padding-bottom: 4.5rem;
    }
    :global(html.js) .steps li {
      position: static;
      padding-top: 0;
      opacity: 1;
    }
    :global(html.js) .steps li::before,
    :global(html.js) .steps li::after {
      content: none;
    }
    :global(html.js) .s-title {
      position: relative;
      padding-top: 0.875rem;
      line-height: 1.3;
      white-space: nowrap;
      color: var(--ink-faint);
      transition: color 400ms var(--ease-out);
    }
    :global(html.js) .steps li.on .s-title {
      color: var(--ink);
    }
    :global(html.js) .s-title::before,
    :global(html.js) .s-title::after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      border-radius: 1px;
      background: var(--line);
    }
    :global(html.js) .s-title::after {
      background: var(--ink);
      transform-origin: 0 50%;
      transform: scaleX(var(--fill, 0));
    }
    :global(html.js) .s-text {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 4rem;
      opacity: 0;
      transition: opacity 400ms var(--ease-out);
    }
    :global(html.js) .steps li.on .s-text {
      opacity: 1;
    }
  }

  /* The smallest phones: the four titles still fit on one line. */
  @media (max-width: 350px) {
    :global(html.js) .s-title {
      font-size: 0.8125rem;
    }
  }

  /* MARK: Phone

     The page made for a phone (.phone, pages/index.astro): not pinned. The heading, the screen,
     then the steps as tabs under it, each line filling while its step plays (the script above),
     with a finger's room to tap one. */
  :global(html.phone) .notch {
    height: auto;
    margin-top: 0;
    padding-block: 5rem 4rem;
  }

  :global(html.phone) .pin {
    position: static;
    height: auto;
    grid-template-rows: none;
    gap: 1.75rem;
    padding: 0;
    overflow: visible;
  }

  :global(html.phone) .copy {
    display: contents;
  }

  :global(html.phone) .copy > * {
    width: min(100% - 2 * var(--gutter), 30rem);
    margin-inline: auto;
  }

  :global(html.phone) .copy .display {
    order: -1;
    max-width: none;
    font-size: var(--t-h2);
  }

  :global(html.phone) .steps {
    margin-top: -0.25rem;
    padding-bottom: 5rem;
  }

  :global(html.phone) .s-title {
    min-height: 2.75rem;
    padding-top: 1rem;
  }

  /* One step's words leave before the next one's arrive, so the two never overlap. */
  :global(html.phone) .s-text {
    height: 4.5rem;
    font-size: var(--t-body);
    transition-duration: 150ms;
  }

  :global(html.phone) .steps li.on .s-text {
    transition-duration: 400ms;
    transition-delay: 150ms;
  }
</style>
