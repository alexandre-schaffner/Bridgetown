---
// Day. What happens to each message: rules first, then Jev's answers as probabilities, then
// a route. Rows play in as you reach them; the bars fill to their numbers.

import { triageRows as rows } from "../lib/messages";
---

<section class="triage day" id="triage" data-sheet data-tone="sunk" aria-labelledby="triage-title">
  <div class="wrap">
    <div class="chapter-head">
      <h2 id="triage-title" class="display">One question for every message.</h2>
      <p class="lead">
        Rules clear the noise first: successful deploys, recoveries, anything already marked resolved. The rest
        goes to Jev, TypeSafe's judgment model, which answers in probabilities you can read. Bridgetown's policy
        turns them into a route, with thresholds you set.
      </p>
    </div>

    <div class="policy" data-policy>
      <label for="threshold">
        <span class="p-title">Your threshold</span>
        <span class="p-text">Start an agent when Jev is at least this sure it can finish the job.</span>
      </label>
      <div class="p-control">
        <input id="threshold" type="range" min="50" max="95" step="1" value="75" data-threshold />
        <output for="threshold" data-threshold-out>75%</output>
      </div>
    </div>

    <ol class="log">
      <li class="log-head" aria-hidden="true">
        <span>Message</span>
        <span>Jev's answers</span>
        <span>Route</span>
      </li>
      {
        rows.map((row) => (
          <li
            class="row"
            data-row
            data-kind={row.kind}
            data-agent={row.answers?.[1]?.[1]}
            data-other={row.answers?.[2]?.[1]}
          >
            <div class="msg">
              <p class="meta">
                <span class="from">{row.from}</span>
                <span class="who">{row.who}</span>
              </p>
              <p class="text">{row.text}</p>
            </div>
            <div class="answers">
              {row.answers ? (
                <dl>
                  {row.answers.map(([q, p], i) => (
                    <div class:list={["answer", i === 1 && "gated"]} style={`--p:${p / 100}`}>
                      <dt>{q}</dt>
                      <dd>
                        <span class="bar" aria-hidden="true">
                          <i />
                          {i === 1 && <b class="tick" />}
                        </span>
                        <span class="pct">{p}%</span>
                      </dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <p class="note">{row.note}</p>
              )}
            </div>
            <p class="route" data-route>
              <i class:list={["dot", `dot-${row.route.dot}`]} aria-hidden="true" />
              <span>{row.route.label}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { $, $$ } from "../lib/dom";
  import { revealOnView } from "../scripts/reveal";
  import { reduced } from "../scripts/scroll";

  const rows = $$("[data-row]");
  revealOnView(rows, { threshold: 0.5, stagger: 160 });

  // The threshold re-routes the messages, as the app's policy does with the one you set.
  const policy = $("[data-policy]");
  if (policy) {
    const input = $<HTMLInputElement>("[data-threshold]", policy)!;
    const out = $("[data-threshold-out]", policy)!;
    const decide = (row: HTMLElement, t: number): [string, string] | null => {
      const agent = Number(row.dataset.agent);
      const other = Number(row.dataset.other);
      if (row.dataset.kind === "alert") {
        if (other >= 50) return null;
        return agent >= t ? ["Agent starts", "blue"] : ["Suggested to you", "amber"];
      }
      if (row.dataset.kind === "inbox") return agent >= t ? ["Agent drafts, you send", "blue"] : ["Needs you", "amber"];
      return null;
    };
    const apply = (animate: boolean) => {
      const t = Number(input.value);
      out.textContent = `${t}%`;
      input.style.setProperty("--fill", `${((t - 50) / 45) * 100}%`);
      for (const row of rows) {
        row.style.setProperty("--threshold", `${t}%`);
        const next = decide(row, t);
        if (!next) continue;
        const route = $("[data-route]", row)!;
        const label = $("span", route)!;
        const dot = $(".dot", route)!;
        if (label.textContent === next[0]) continue;
        label.textContent = next[0];
        dot.className = `dot dot-${next[1]}`;
        if (animate && !reduced) {
          label.animate(
            [
              { opacity: 0, transform: "translateY(40%)", filter: "blur(4px)" },
              { opacity: 1, transform: "none", filter: "blur(0)" },
            ],
            { duration: 420, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
          );
          dot.animate([{ transform: "scale(0)" }, { transform: "scale(1.5)" }, { transform: "none" }], { duration: 500 });
        }
      }
    };
    input.addEventListener("input", () => apply(true));
    apply(false);
  }
</script>

<style>
  .triage {
    padding-block: clamp(6rem, 14vh, 10rem);
  }

  /* It slides in over the notch's last screen; on a phone nothing is pinned to slide over. */
  :global(html.js) .triage {
    margin-top: -100svh;
  }

  :global(html.phone) .triage {
    margin-top: 0;
  }

  .chapter-head .display {
    max-width: 12ch;
  }

  .log {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .log-head,
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(10rem, 0.42fr);
    gap: 2.5rem;
  }

  .log-head {
    padding: 0.75rem 0;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-faint);
    border-bottom: 1px solid var(--line);
  }

  .row {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  .meta {
    display: flex;
    gap: 0.625rem;
    margin-bottom: 0.375rem;
    font-size: 0.8125rem;
  }

  .from {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-dim);
  }

  .who {
    color: var(--ink-faint);
  }

  .text {
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: -0.01em;
    font-weight: 450;
  }

  dl {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .answer {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  dt {
    color: var(--ink-dim);
  }

  dd {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }

  .bar {
    height: 3px;
    border-radius: 2px;
    background: var(--line);
  }

  .bar i {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--ink);
    transform-origin: 0 50%;
    transform: scaleX(var(--p));
    transition: transform 1100ms var(--ease-out);
  }

  .pct {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  .note {
    font-size: 0.875rem;
    color: var(--ink-faint);
  }

  .route {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 540;
    font-size: 0.9375rem;
  }

  .dot-grey {
    color: var(--ink-faint);
  }

  /* Rows wait, then play: the message, the bars filling, the route. */
  :global(html.js) .row:not(.in) .bar i {
    transform: scaleX(0);
  }

  :global(html.js) .row .route {
    transition:
      opacity 500ms var(--ease-out) 700ms,
      translate 700ms var(--ease-out) 700ms;
  }

  :global(html.js) .row:not(.in) .route {
    opacity: 0;
    translate: -0.5rem 0;
  }

  @media (max-width: 900px) {
    .log-head {
      display: none;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  /* The policy control: one threshold, the routes follow it. */
  .policy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.9fr);
    gap: 1rem 3rem;
    align-items: center;
    margin-bottom: 2rem;
    padding: 1.25rem 1.5rem;
    border-radius: 14px;
    background: var(--day);
    box-shadow: 0 0 0 1px var(--line);
  }

  .policy label {
    display: grid;
    gap: 0.25rem;
  }

  .p-title {
    font-weight: 560;
  }

  .p-text {
    color: var(--ink-dim);
    font-size: var(--t-small);
  }

  .p-control {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: 1rem;
  }

  output {
    font-size: 1.375rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  input[type="range"] {
    --fill: 55.5%;
    appearance: none;
    -webkit-appearance: none;
    height: 1.5rem;
    background: transparent;
    cursor: pointer;
  }

  input[type="range"]::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--ink) var(--fill), var(--line-strong) var(--fill));
  }

  input[type="range"]::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--ink) var(--fill), var(--line-strong) var(--fill));
  }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: -0.5625rem;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 2px 6px oklch(0.19 0.008 255 / 0.25);
    transition: transform 200ms var(--ease-out);
  }

  input[type="range"]::-moz-range-thumb {
    width: 1.375rem;
    height: 1.375rem;
    border: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 2px 6px oklch(0.19 0.008 255 / 0.25);
  }

  input[type="range"]:active::-webkit-slider-thumb {
    transform: scale(1.15);
  }

  /* The threshold, marked on the bar it gates. */
  .bar {
    position: relative;
  }

  .tick {
    position: absolute;
    top: -4px;
    bottom: -4px;
    left: var(--threshold, 75%);
    width: 2px;
    margin-left: -1px;
    border-radius: 1px;
    background: var(--blue);
    transition: left 160ms var(--ease-out);
  }

  .gated .bar {
    overflow: visible;
  }

  .gated .bar i {
    border-radius: 2px;
  }

  .route span {
    display: inline-block;
  }

  @media (max-width: 900px) {
    .policy {
      grid-template-columns: 1fr;
    }
  }
</style>
