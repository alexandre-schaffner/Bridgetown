---
// Day, first thing through the arch: twenty seconds of a morning, recorded. The clip comes up
// out of the hero's light, small between the two halves of the line, and grows to fill the
// screen as you scroll. A phone plays its own cut, zoomed on the notch as the next chapter is
// (scripts/record.ts, island-phone): the whole screen at a phone's width can't be read.
import Icon from "./Icon.astro";
---

<section class="recording day" id="recording" data-recording aria-labelledby="recording-title">
  <div class="pin">
    <h2 id="recording-title" class="line">
      <span class="half left">You keep</span>
      <span class="half right">working.</span>
    </h2>

    <figure class="clip">
      <div class="frame">
        <video
          data-clip-video
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="A screen recording: tests run in a terminal while Bridgetown's island shows agents at work, drops a banner for a merge, opens, and the merge is settled from the notch."
        >
          <source src="/media/island-phone.mp4" type="video/mp4" media="(max-width: 600px)" />
          <source src="/media/island.mp4" type="video/mp4" />
        </video>
        <button class="toggle" type="button" data-clip-toggle aria-label="Pause the recording">
          <span class="pause"><Icon name="pause" size={14} stroke={2.2} /></span>
          <span class="play"><Icon name="play" size={14} stroke={2.2} /></span>
        </button>
      </div>
      <figcaption class="caption">
        <p>
          Twenty seconds of a morning, recorded: tests run, a merge becomes yours, you settle it from the notch, and the
          terminal never loses focus.
        </p>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import { $ } from "../lib/dom";
  import { clamp, inOut, lerp, smooth } from "../lib/math";
  import { reduced, ScrollTrigger } from "../scripts/scroll";

  // The clip grows from between the two halves of its line to fill the screen, and plays
  // only while you can see it.
  const recording = $("[data-recording]");
  if (recording) {
    const video = $<HTMLVideoElement>("[data-clip-video]", recording)!;
    const toggle = $<HTMLButtonElement>("[data-clip-toggle]", recording)!;
    let userPaused = reduced;
    const setPaused = (paused: boolean) => {
      toggle.classList.toggle("paused", paused);
      toggle.setAttribute("aria-label", paused ? "Play the recording" : "Pause the recording");
    };
    setPaused(userPaused);
    toggle.addEventListener("click", () => {
      userPaused = !video.paused;
      if (userPaused) video.pause();
      else void video.play().catch(() => {
        userPaused = true;
        setPaused(true);
      });
      setPaused(userPaused);
    });
    let inView = false;
    const resume = () => {
      if (inView && !userPaused) void video.play().catch(() => setPaused(true));
      else video.pause();
    };
    new IntersectionObserver(
      ([e]) => {
        inView = e!.isIntersecting;
        resume();
      },
      { threshold: 0.25 },
    ).observe(video);

    // The cut whose width this is, under its own poster. The browser picks a <source> once, so
    // a phone turned on its side, or a window narrowed past a phone's width, swaps it here (as
    // does a browser that ignores `media` and took the first).
    const sources = [...video.querySelectorAll("source")];
    const cut = () => sources.find((s) => !s.media || matchMedia(s.media).matches)!.src;
    const sync = () => {
      const src = cut();
      video.poster = src.replace(/\.mp4$/, "-poster.jpg");
      if (!video.currentSrc || video.currentSrc === src) return;
      video.src = src;
      resume();
    };
    sync();
    video.addEventListener("loadedmetadata", sync);
    for (const { media } of sources) if (media) matchMedia(media).addEventListener("change", sync);

    // In screens of scroll since the pin took hold: the first stretch lies over the hero's walk
    // into the light, and the screen develops out of it; then the clip grows.
    const set = (name: string, v: number, digits = 3) => recording.style.setProperty(name, v.toFixed(digits));
    const play = (d: number) => {
      set("--enter", smooth(0.05, 0.65, d));
      if (reduced) return;
      set("--grow", lerp(0.34, 1, inOut(clamp((d - 0.75) / 1.15))), 4);
      set("--out", smooth(0.95, 1.45, d));
      set("--caption", smooth(1.65, 2.05, d));
    };
    if (reduced) {
      // The clip at full size; the line's halves would only stand cut off at its sides. It still
      // fades in out of the light, or it would stand over the hero's board.
      for (const name of ["--grow", "--out", "--caption"]) set(name, 1);
    }
    play(0);
    ScrollTrigger.create({
      trigger: recording,
      start: "top top",
      end: "bottom bottom",
      onUpdate: (s) => play((s.progress * (recording.offsetHeight - innerHeight)) / innerHeight),
    });
  }
</script>

<style>
  /* The film's shape, and the room its line and caption need above and below it at full size. */
  .recording {
    --film: 1600 / 996;
    --room: 12rem;
    padding-block: clamp(5rem, 12vh, 8rem);
  }

  .pin {
    display: grid;
    justify-items: center;
    gap: 2.5rem;
    width: min(100% - 2 * var(--gutter), 96rem);
    margin-inline: auto;
  }

  .line {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 0.3em;
    font-size: var(--t-h1);
    line-height: 1;
    letter-spacing: -0.04em;
    text-align: center;
  }

  .half {
    display: inline-block;
  }

  .clip {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: var(--film);
    border-radius: 18px;
    overflow: hidden;
    /* The poster, there before the script and without it (which sets the video's own). */
    background: #0d0e10 url("/media/island-poster.jpg") center / cover no-repeat;
    box-shadow:
      0 1px 2px oklch(0.19 0.008 255 / 0.1),
      0 50px 100px -50px oklch(0.19 0.008 255 / 0.55);
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .toggle {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: oklch(0.12 0.006 255 / 0.55);
    color: #fff;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    cursor: pointer;
    opacity: 0;
    transition: opacity 300ms var(--ease-out);
  }

  .frame:hover .toggle,
  .toggle:focus-visible {
    opacity: 1;
  }

  /* Without hover, there is no other way to find it, and a finger needs the room. */
  @media (hover: none) {
    .toggle {
      opacity: 1;
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .toggle .play,
  .toggle:global(.paused) .pause {
    display: none;
  }

  .toggle:global(.paused) .play {
    display: grid;
  }

  .toggle .pause {
    display: grid;
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 3rem;
  }

  .caption p {
    max-width: 36rem;
    color: var(--ink-dim);
  }

  /* With script, pinned while the clip grows; the line parts around it. Its first 160svh lie
     over the end of the hero and are see-through, so the light you walk into is what the line
     and the screen come out of (the script above). The next chapter slides over its last 100svh. */
  :global(html.js) .recording {
    --enter: 1;
    height: 450svh;
    margin-top: -160svh;
    padding: 0;
    background: none;
  }

  :global(html.js) .recording::before {
    content: "";
    position: absolute;
    inset: 160svh 0 0;
    background: var(--day);
  }

  :global(html.js) .pin {
    /* The clip at full size; the line is sized so both halves fit beside it at its smallest. */
    --clip-w: min(100cqw - 2 * var(--gutter), 96rem, (100svh - var(--room)) * var(--film));
    position: sticky;
    top: 0;
    height: 100svh;
    align-content: center;
    width: 100%;
    overflow: hidden;
    container-type: inline-size;
    transform-origin: 50% 30%;
  }

  /* Each half hugs the clip's edge, a little apart from it, and is pushed out as it grows. */
  :global(html.js) .line {
    position: absolute;
    inset: 0;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0;
    font-size: min(var(--t-h1), (50cqw - var(--gutter) - var(--clip-w) * 0.17) / 4.3);
    pointer-events: none;
  }

  :global(html.js) .half {
    flex: 1 1 0;
    opacity: calc(var(--enter) * (1 - var(--out, 0)));
    filter: blur(calc((1 - var(--enter)) * 14px));
  }

  /* Out of the light, the halves part from the middle as the screen opens between them. */
  :global(html.js) .half.left {
    text-align: right;
    translate: calc(-1 * (var(--clip-w) * var(--grow, 0.34) / 2 + 0.3em) * (0.55 + 0.45 * var(--enter))) 0;
  }

  :global(html.js) .half.right {
    text-align: left;
    translate: calc((var(--clip-w) * var(--grow, 0.34) / 2 + 0.3em) * (0.55 + 0.45 * var(--enter))) 0;
  }

  :global(html.js) .clip {
    width: var(--clip-w);
    opacity: var(--enter);
    transform: scale(calc(var(--grow, 0.34) * (0.6 + 0.4 * var(--enter))));
    transform-origin: 50% 50%;
  }

  /* The screen develops out of the white. */
  :global(html.js) .frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--day);
    opacity: calc(1 - var(--enter));
    pointer-events: none;
  }

  :global(html.js) .frame {
    box-shadow:
      0 1px 2px oklch(0.19 0.008 255 / calc(0.1 * var(--enter))),
      0 50px 100px -50px oklch(0.19 0.008 255 / calc(0.55 * var(--enter)));
  }

  :global(html.js) .caption {
    opacity: var(--caption, 0);
    translate: 0 calc((1 - var(--caption, 0)) * 1rem);
  }

  /* The phone cut (the <source> above, at the same width): its own shape and poster, and as
     wide as the screen while it and the caption still fit under it. */
  @media (max-width: 600px) {
    .recording {
      --film: 400 / 440;
      --room: 15rem;
    }
    .frame {
      border-radius: 14px;
      background-image: url("/media/island-phone-poster.jpg");
    }
  }

  @media (max-width: 760px) {
    :global(html.js) .line {
      flex-direction: column;
      justify-content: space-between;
      padding-block: 18svh;
    }
    :global(html.js) .line {
      font-size: var(--t-h1);
    }
    :global(html.js) .half {
      flex: none;
    }
    :global(html.js) .half.left,
    :global(html.js) .half.right {
      translate: 0 0;
    }
  }
</style>
