---
// Bridgetown in the notch (app/Sources/Bridgetown/Island/): one black shape that hangs from
// the notch and morphs between hidden, wings, a banner and the whole app. Every layer is laid
// out at its final size and revealed by the shape as it grows. Open, it is the app itself:
// real screens (src/assets/app/), exactly the open island's size, so each fills the shape
// from its top edge, its header beside the notch. scripts/island.ts drives it.
import ArchMark from "./ArchMark.astro";
import AppShot from "./AppShot.astro";
import Icon from "./Icon.astro";
import { BOX_W, layoutFor, NOTCH, WING } from "../lib/notch";
import overview from "../assets/app/overview.png";
import sessionMerge from "../assets/app/session-merge.png";
import sessionMerged from "../assets/app/session-merged.png";

// Each layer is laid out where its presentation's shape will be: under the notch, in the box.
const banner = layoutFor("banner");
const open = layoutFor("open");
const geometry = {
  "--box-w": `${BOX_W}px`,
  "--box-h": `${open.height}px`,
  "--notch-w": `${NOTCH.width}px`,
  "--notch-h": `${NOTCH.height}px`,
  "--wing": `${WING}px`,
  "--banner-w": `${banner.width}px`,
  "--banner-h": `${banner.height - NOTCH.height}px`,
  "--open-w": `${open.width}px`,
};

/** A box on the open screens, in their points (the 2× captures' pixels halved), as CSS. */
const at = (x: number, y: number, width: number, height: number) => ({
  "--x": `${x}px`,
  "--y": `${y}px`,
  "--w": `${width}px`,
  "--h": `${height}px`,
});
// The decision the tour settles: its Merge button, measured from session-merge.png.
const merge = at(418.5, 325.5, 58.5, 28);
// The overview's own wings, under the live ones (they sit a few points apart: the capture's
// notch is not the drawn screen's).
const wingMarks = [at(420, 0, 38, 32), at(642, 0, 38, 32)];
---

<div class="island" data-island aria-hidden="true" style={geometry}>
  <svg class="shape" width={BOX_W} height={open.height} viewBox={`0 0 ${BOX_W} ${open.height}`} aria-hidden="true">
    <defs>
      <linearGradient id="island-edge" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
        <stop offset="0.5" stop-color="#fff" stop-opacity="0.07"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0.16"></stop>
      </linearGradient>
    </defs>
    <path class="fill" data-island-fill></path>
  </svg>

  <div class="clip" data-island-clip>
    <!-- Open: the overview, and the session with a merge waiting, before and after it. A
         session takes the place of the last two columns; prod stays put. -->
    <div class="layer open" data-layer="open">
      <AppShot src={overview} alt="" class="view" data-app-screen="overview" />
      <AppShot src={sessionMerge} alt="" class="view" data-app-screen="merge" />
      <AppShot src={sessionMerged} alt="" class="view" data-app-screen="merged" />
      {wingMarks.map((m) => <span class="mask" style={m}></span>)}
      <span class="press" style={merge} data-press></span>
      <button class="target" type="button" tabindex="-1" style={merge} data-target="merge"></button>
    </div>

    <!-- The wings, either side of the notch: the arch for agents at work, a count for what
         needs you. They stay as the island opens, as the app keeps them in its band. -->
    <div class="layer wings" data-layer="wings">
      <span class="wing left"><span class="glyph" data-wing-glyph><ArchMark size={14} /></span></span>
      <span class="wing right">
        <i class="dot" data-wing-dot></i>
        <b data-wing-number>11</b>
      </span>
    </div>

    <!-- A new "Needs you", for a few seconds. -->
    <div class="layer banner" data-layer="banner">
      <span class="b-glyph"><Icon name="git-merge" size={14} stroke={2} /></span>
      <span class="b-text">
        <span class="b-kind">Needs you</span>
        <span class="b-title">Merge fix(app): import d3-shape from the package root</span>
      </span>
      <Icon name="chevron-down" size={12} stroke={2.4} class="b-chev" />
    </div>
  </div>

  <svg class="edge-svg" width={BOX_W} height={open.height} viewBox={`0 0 ${BOX_W} ${open.height}`} aria-hidden="true">
    <path class="edge" data-island-edge stroke="url(#island-edge)"></path>
  </svg>

  <!-- After the tour the island answers the pointer: hover swells the wings, a click opens it
       or folds it away, and the Merge above settles what it opened on. A flourish for the
       pointer only: the screen's label already says what the island does. -->
  <button class="hit" type="button" tabindex="-1" data-island-hit></button>
</div>

<style>
  .island {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--box-w);
    height: var(--box-h);
    margin-left: calc(var(--box-w) / -2);
    color: var(--ui-text);
    font-size: 12px;
    line-height: 1.35;
    pointer-events: none;
    z-index: 5;
  }

  .shape,
  .edge-svg {
    position: absolute;
    inset: 0;
    overflow: visible;
  }

  .fill {
    fill: #000;
    filter: drop-shadow(0 14px 26px rgb(0 0 0 / var(--lift, 0))) drop-shadow(0 2px 4px rgb(0 0 0 / calc(var(--lift, 0) * 0.55)));
  }

  .edge {
    fill: none;
    stroke-width: 1;
    opacity: var(--lift-edge, 0);
  }

  .clip {
    position: absolute;
    inset: 0;
  }

  .layer {
    position: absolute;
    opacity: 0;
    filter: blur(10px);
    transform: scale(0.96);
    transform-origin: 50% 0;
    will-change: opacity, filter, transform;
  }

  /* Wings. */
  .wings {
    top: 0;
    left: 0;
    right: 0;
    height: var(--notch-h);
  }

  .wing {
    position: absolute;
    top: 0;
    height: var(--notch-h);
    width: var(--wing);
    display: grid;
    place-items: center;
  }

  .wing.left {
    left: calc(var(--box-w) / 2 - var(--notch-w) / 2 - var(--wing));
  }

  .wing.right {
    left: calc(var(--box-w) / 2 + var(--notch-w) / 2);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
  }

  .wing.right b {
    font-size: 12.5px;
    font-weight: 620;
    font-variant-numeric: tabular-nums;
  }

  .wing.right .dot {
    width: 5px;
    height: 5px;
    color: var(--blue);
  }

  .glyph {
    display: grid;
    color: var(--ui-text);
    transition: filter 600ms var(--ease-out);
  }

  .glyph:global(.working) {
    animation: island-glow 2.4s ease-in-out infinite;
  }

  @keyframes island-glow {
    0%,
    100% {
      filter: drop-shadow(0 0 3px oklch(0.63 0.19 252 / 0.35));
    }
    50% {
      filter: drop-shadow(0 0 7px oklch(0.63 0.19 252 / 0.9)) drop-shadow(0 0 10px oklch(0.63 0.19 252 / 0.3));
    }
  }

  /* Banner. */
  .banner {
    top: var(--notch-h);
    left: calc((var(--box-w) - var(--banner-w)) / 2);
    width: var(--banner-w);
    height: var(--banner-h);
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    align-items: center;
    gap: 11px;
    padding: 0 16px;
  }

  .b-glyph {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: var(--amber);
    background: oklch(0.8 0.15 74 / 0.14);
  }

  .b-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .b-kind {
    font-size: 10.5px;
    font-weight: 500;
    color: var(--amber);
  }

  .b-title {
    font-size: 13px;
    font-weight: 620;
    letter-spacing: -0.015em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .banner :global(.b-chev) {
    color: var(--ui-faint);
  }

  /* Open: the screens, one over another, in the island's body between its shoulders. */
  .open {
    top: 0;
    left: calc((var(--box-w) - var(--open-w)) / 2);
    width: var(--open-w);
    height: var(--box-h);
  }

  .view {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 280ms var(--ease-out);
  }

  /* The screen showing (scripts/island.ts sets data-view on the island). */
  .island:global([data-view="overview"]) [data-app-screen="overview"],
  .island:global([data-view="merge"]) [data-app-screen="merge"],
  .island:global([data-view="merged"]) [data-app-screen="merged"] {
    opacity: 1;
  }

  /* Boxes on the screens, placed in their points. */
  .mask,
  .press,
  .target {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
  }

  .mask {
    background: #000;
  }

  /* The Merge button under the pointer, then pressed: drawn over the screen's own. */
  .press {
    border-radius: 8px;
    opacity: 0;
    transition:
      opacity 160ms var(--ease-out),
      background-color 160ms var(--ease-out);
  }

  .press:global(.hover) {
    opacity: 1;
    background: rgb(255 255 255 / 0.3);
  }

  .press:global(.press) {
    opacity: 1;
    background: rgb(0 0 0 / 0.16);
  }

  .target {
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
  }

  /* It answers only open, on its own screen. */
  .island:global(.is-open[data-view="merge"]) [data-target="merge"] {
    pointer-events: auto;
  }

  /* The screen is drawn small on a phone: a larger target than the button shows. */
  .target::after {
    content: "";
    position: absolute;
    inset: -10px -6px;
  }

  @media (prefers-reduced-motion: reduce) {
    .view {
      transition-duration: 180ms;
    }
  }

  /* Around the wings, and across the whole island once it is open. The screen is drawn scaled
     down by --k (scripts/island.ts), so the strip grows to stay a finger's height. */
  .hit {
    position: absolute;
    top: 0;
    left: 50%;
    width: 300px;
    height: max(calc(var(--notch-h) + 8px), calc(44px / var(--k, 1)));
    translate: -50% 0;
    padding: 0;
    border: 0;
    border-radius: 0 0 16px 16px;
    background: transparent;
    pointer-events: auto;
    cursor: pointer;
  }

  .island:global(.is-open) .hit {
    width: var(--box-w);
  }

  /* Without script nothing answers a click: no pointer over the notch either. */
  :global(html:not(.js)) .hit {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph:global(.working) {
      animation: none;
    }
  }
</style>
