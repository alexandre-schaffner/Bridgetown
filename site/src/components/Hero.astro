---
import AppShot from "./AppShot.astro";
import Icon from "./Icon.astro";
import { download } from "../lib/download";
import overview from "../assets/app/overview.png";
// Night, before dawn. The headline, large and alone, over the light breaking along the edge of
// a dark world (scripts/dawn.ts). Scrolling raises Bridgetown out of that light, open as you
// would find it: prod, what needs you, what the agents are doing. Then day floods the frame
// and becomes the next chapter's screen.

const overviewAlt =
  "Bridgetown open. Prod: API 5xx at 75, 4.9 times usual. Needs you, 12: answer Hugo about the sparkline work, reply to Pierre, switch the keeper's Arbitrum RPC. Agents, 6: on merkl-api alerts, one queued, one fixing, one in review, one starting.";
---

<section class="hero night" id="top" data-hero aria-labelledby="hero-title">
  <div class="stage">
    <div class="intro" data-hero-intro>
      <p class="kicker" data-rise>Bridgetown for macOS</p>
      <h1 id="hero-title" data-split>Your alerts, handled before you&nbsp;look.</h1>
      <p class="lead" data-rise>
        A Mac app in your notch. It reads your team's Slack alerts and the messages sent to you, gives coding agents
        the work they can finish, and brings you the rest.
      </p>
      <div class="actions" data-rise>
        <a class="button button-light" href={download.url} data-download>
          <Icon name="download" size={15} stroke={2.2} />
          Download for macOS
        </a>
        <button class="watch" type="button" data-open-film="launch">
          <span class="disc"><Icon name="play" size={12} stroke={2.4} /></span>
          Watch the film
        </button>
      </div>
      <p class="meta mono" data-rise>{download.meta}</p>
    </div>

    <p class="caption" data-hero-caption>
      Every alert channel, every mention, every direct message, read the moment it lands.
    </p>

    <div class="board-wrap" data-board-wrap>
      <div class="board" data-board-tilt>
        <AppShot src={overview} alt={overviewAlt} edge loading="eager" />
      </div>
    </div>
  </div>
</section>

<style>
  .stage {
    display: grid;
    gap: 4rem;
    justify-items: center;
    padding: 9rem var(--gutter) 5rem;
    text-align: center;
  }

  .intro {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }

  .kicker {
    font-size: var(--t-small);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--night-dim);
  }

  h1 {
    --size: clamp(3rem, 6.4vw + 0.5rem, 6rem);
    max-width: 13ch;
    font-size: var(--size);
    line-height: 1;
    letter-spacing: -0.038em;
    font-weight: 600;
  }

  /* Each word rises out of its own line (scripts/main.ts). */
  h1 :global(.w) {
    display: inline-block;
    /* Room for descenders inside the mask. */
    padding-block: 0.04em 0.14em;
    margin-block: -0.04em -0.14em;
    overflow: hidden;
    vertical-align: top;
  }

  h1 :global(.wi) {
    display: inline-block;
    transform-origin: 0 100%;
  }

  .intro .lead {
    max-width: 37rem;
    margin-top: 0.25rem;
    font-size: var(--t-lead);
    color: var(--night-dim);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.75rem;
  }

  .meta {
    margin-top: -0.5rem;
    color: var(--night-faint);
  }

  .watch {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--night-ink);
    font-size: 0.9375rem;
    font-weight: 520;
    cursor: pointer;
  }

  .disc {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.35);
    transition:
      background-color 250ms var(--ease-out),
      transform 400ms var(--ease-out);
  }

  .watch:hover .disc {
    background: oklch(1 0 0 / 0.14);
    transform: scale(1.08);
  }

  .caption {
    max-width: 24ch;
    font-size: var(--t-h3);
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 540;
    color: var(--night-dim);
  }

  /* With script: one viewport, pinned, while the board rises and the day comes. */
  :global(html.js) .hero {
    height: 360svh;
    cursor: auto;
  }

  :global(html.js) .stage {
    position: sticky;
    top: 0;
    display: block;
    height: 100svh;
    padding: 0;
    /* Clipped, not scrollable: focusing a button on it must never pan the stage. */
    overflow: clip;
  }

  /* Centred in the room between the nav and the board's peeking edge (86% down, from `peek`
     in scripts/main.ts); on a short screen it starts under the nav rather than behind it. */
  :global(html.js) .intro {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: var(--nav-h);
    bottom: 18svh;
    z-index: 2;
    align-content: safe center;
  }

  :global(html.js) .caption {
    position: absolute;
    left: 50%;
    top: max(5.5rem, 50% - var(--board-h, 32rem) / 2 - 7.5rem);
    z-index: 2;
    width: max-content;
    max-width: min(30ch, 100vw - 2 * var(--gutter));
    translate: -50% 0;
    opacity: 0;
    visibility: hidden;
  }

  /* MARK: The board */

  /* The app itself, open (components/AppShot.astro). Never wider than its own 1100 points,
     and with script never so tall that it reaches the caption above it. */
  .board-wrap {
    --board-w: min(68.75rem, 100vw - 2 * var(--gutter));
    width: var(--board-w);
  }

  /* Centred, rising out of the light as you scroll (scripts/main.ts moves it). */
  :global(html.js) .board-wrap {
    --board-w: min(68.75rem, 100vw - 2 * var(--gutter), (100svh - 23rem) * 2.148);
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    translate: -50% -50%;
    opacity: 0;
  }

  /* It leans toward the pointer (scripts/main.ts). */
  .board {
    transform-origin: 50% 60%;
    will-change: transform;
  }

  /* A phone: too narrow for the whole app to read, so it shows what needs you, the middle
     column, cut from the full height. */
  @media (max-width: 600px) {
    .board-wrap,
    :global(html.js) .board-wrap {
      --board-w: calc(100vw - 2 * var(--gutter));
    }
    .board :global(.app-shot) {
      --ratio: auto;
      --focus: 50% 0;
      --radius: 1.5rem;
      height: min(var(--board-w) * 1.25, 100svh - 21rem);
    }
  }

  /* The board's top edge rises to where this line sits. */
  @media (max-height: 700px) {
    .meta {
      display: none;
    }
  }

  /* Short screens: a phone with its toolbars showing, or turned sideways. */
  @media (max-height: 640px) {
    h1 {
      font-size: min(var(--size), 9svh);
    }
    :global(html.js) .intro {
      gap: 0.75rem;
    }
    .intro .lead {
      font-size: var(--t-body);
    }
    .actions {
      margin-top: 0.25rem;
      gap: 0.5rem 1.5rem;
    }
  }

  /* A phone sideways: a shorter board, and no caption to hide behind it. */
  @media (max-height: 560px) and (orientation: landscape) {
    :global(html.js) .board-wrap {
      --board-w: min(100vw - 2 * var(--gutter), (100svh - 8rem) * 2.148);
    }
    :global(html.js) .caption {
      display: none;
    }
  }
</style>
