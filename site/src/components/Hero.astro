---
import Icon from "./Icon.astro";
import { download } from "../lib/download";
// Night. The arch stands in the dark with the light behind it; scrolling walks the camera
// through the opening until the light is all there is. Three captions play on the way.
---

<section class="hero night" id="top" data-hero aria-labelledby="hero-title">
  <div class="stage">
    <div class="beat beat-intro" data-beat>
      <p class="kicker">Bridgetown for macOS</p>
      <h1 id="hero-title" data-split>Your alerts, handled before you&nbsp;look.</h1>
      <div class="intro-side">
        <p class="lead">
          A Mac app in your notch. It reads your team's Slack alerts and the messages sent to you, gives coding
          agents the work they can finish, and brings you the rest.
        </p>
        <div class="actions">
          <a class="button button-light" href={download.url} data-download>
            <Icon name="download" size={15} stroke={2.2} />
            Download for macOS
          </a>
          <a class="watch" href="/media/launch.mp4" data-open-film>
            <span class="disc"><Icon name="play" size={12} stroke={2.4} /></span>
            Watch the film
          </a>
        </div>
        <p class="meta mono">{download.meta}</p>
      </div>
    </div>

    <p class="beat beat-line" data-beat>
      Every alert channel, every mention, every direct message: read the moment it lands.
    </p>
    <p class="beat beat-line" data-beat>
      Each one gets a single question. <span class="soft">Can an agent finish this, or does it need you?</span>
    </p>

    <div class="cue" data-cue aria-hidden="true">
      <span>Scroll through</span>
      <i></i>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
  }

  .stage {
    display: grid;
    gap: 4rem;
    align-content: end;
    min-height: 100svh;
    padding: 7rem var(--gutter) 3.5rem;
  }

  .kicker {
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--night-dim);
  }

  h1 {
    font-size: var(--t-h1);
    line-height: 0.98;
    letter-spacing: -0.038em;
    font-weight: 580;
    max-width: 11ch;
  }

  .beat-intro {
    display: grid;
    gap: 1.5rem;
    max-width: min(44rem, 52vw);
  }

  .intro-side {
    display: grid;
    gap: 1.75rem;
  }

  .intro-side .lead {
    font-size: var(--t-body);
    max-width: 27rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .meta {
    margin-top: -0.5rem;
    color: var(--night-faint);
  }

  .watch {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--night-ink);
    font-size: 0.9375rem;
    font-weight: 520;
    text-decoration: none;
  }

  .disc {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.35);
    transition:
      background-color 250ms var(--ease-out),
      transform 400ms var(--ease-out);
  }

  .watch:hover .disc {
    background: oklch(1 0 0 / 0.14);
    transform: scale(1.08);
  }

  .beat-line {
    max-width: 22ch;
    font-size: var(--t-h2);
    line-height: 1.06;
    letter-spacing: -0.03em;
    font-weight: 560;
  }

  .soft {
    color: var(--night-dim);
  }

  .cue {
    display: none;
  }

  /* With script: one viewport, pinned, while the camera moves. Beats stack in one place. */
  :global(html.js) .hero {
    height: 420svh;
  }

  :global(html.js) .stage {
    position: sticky;
    top: 0;
    display: block;
    height: 100svh;
    min-height: 0;
    overflow: hidden;
  }

  /* A floor of shadow under the captions, so the words hold over white stone. */
  :global(html.js) .stage::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 55%;
    background: linear-gradient(180deg, transparent, oklch(0.1 0.006 255 / 0.72));
    opacity: var(--scrim, 1);
    pointer-events: none;
  }

  :global(html.js) .beat {
    z-index: 1;
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(2.5rem, 7svh, 4.5rem);
  }

  :global(html.js) .beat-line {
    opacity: 0;
    visibility: hidden;
  }

  :global(html.js) .cue {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    display: grid;
    justify-items: center;
    gap: 0.625rem;
    translate: -50% 0;
    font-size: 0.75rem;
    color: var(--night-faint);
  }

  .cue i {
    position: relative;
    width: 1px;
    height: 2.25rem;
    overflow: hidden;
    background: oklch(1 0 0 / 0.15);
  }

  .cue i::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--night-ink);
    animation: hero-cue 2.2s var(--ease-in-out) infinite;
  }

  @keyframes hero-cue {
    0% {
      translate: 0 -100%;
    }
    60%,
    100% {
      translate: 0 100%;
    }
  }

  @media (max-width: 860px) {
    .beat-intro {
      max-width: none;
    }
    /* The arch stands behind the words here; a scrim keeps them readable. */
    :global(html.js) .beat-intro::before {
      content: "";
      position: absolute;
      inset: -40vh calc(-1 * var(--gutter)) -6rem;
      z-index: -1;
      background: linear-gradient(180deg, transparent, oklch(0.12 0.006 255 / 0.85) 45%);
      pointer-events: none;
    }
    :global(html.js) .cue {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cue i::after {
      animation: none;
    }
  }
</style>
