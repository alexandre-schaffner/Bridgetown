---
import ArchMark from "./ArchMark.astro";
import Icon from "./Icon.astro";
---

<header class="nav">
  <a class="brand" href="#top" aria-label="Bridgetown, back to top">
    <ArchMark size={17} />
    <span>Bridgetown</span>
  </a>
  <nav aria-label="Sections">
    <ul>
      <li><a href="#notch">Notch</a></li>
      <li><a href="#journey">Agents</a></li>
      <li><a href="#light">The light</a></li>
      <li><a href="#safety">Safety</a></li>
    </ul>
  </nav>
  <div class="end">
    <div class="theme" role="group" aria-label="Theme" data-theme-switch hidden>
      <button type="button" data-theme-option="light" aria-label="Light theme" title="Light"><Icon name="sun" size={14} stroke={2} /></button>
      <button type="button" data-theme-option="dark" aria-label="Dark theme" title="Dark"><Icon name="moon" size={14} stroke={2} /></button>
      <button type="button" data-theme-option="system" aria-label="Match the system theme" title="System"><Icon name="monitor" size={14} stroke={2} /></button>
    </div>
    <a class="cta" href="#access">Request access</a>
  </div>
</header>

<script>
  import { $, $$ } from "../lib/dom";
  import { onScroll, reduced } from "../scripts/scroll";

  // Light, dark, or whatever the system says; remembered. The new theme opens as a circle
  // from the switch, and "themechange" tells the arch's flood to follow (scripts/main.ts).
  const themeSwitch = $("[data-theme-switch]");
  if (themeSwitch) {
    themeSwitch.hidden = false;
    const root = document.documentElement;
    const system = matchMedia("(prefers-color-scheme: dark)");
    const buttons = $$<HTMLButtonElement>("[data-theme-option]", themeSwitch);
    const resolve = (choice: string) => choice === "dark" || (choice === "system" && system.matches);
    const sync = () => {
      const choice = root.dataset.theme ?? "light";
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.themeOption === choice)));
      dispatchEvent(new Event("themechange"));
    };
    const apply = (choice: string, from?: HTMLElement) => {
      const flip = () => {
        root.dataset.theme = choice;
        root.classList.toggle("theme-dark", resolve(choice));
        sync();
      };
      try {
        localStorage.setItem("bridgetown-theme", choice);
      } catch {
        // Private mode: the choice lasts for this visit.
      }
      if (resolve(choice) === root.classList.contains("theme-dark") || reduced || !document.startViewTransition || !from) {
        flip();
        return;
      }
      const r = from.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      document.startViewTransition(flip).ready.then(() => {
        document.documentElement.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 900, easing: "cubic-bezier(0.65, 0, 0.35, 1)", pseudoElement: "::view-transition-new(root)" },
        );
      });
    };
    buttons.forEach((b) => b.addEventListener("click", () => apply(b.dataset.themeOption!, b)));
    system.addEventListener("change", () => {
      if (root.dataset.theme === "system") apply("system");
    });
    sync();
  }

  // The nav steps aside while you read down, and comes back when you scroll up. Lenis reports
  // a keyboard or scrollbar jump twice, the second time 400ms later without moving; only
  // movement counts.
  let lastY = 0;
  onScroll((y) => {
    if (y === lastY) return;
    document.documentElement.classList.toggle("nav-hidden", y > lastY && y > 200);
    lastY = y;
  });
</script>

<style>
  /* Drawn in white and inverted against whatever is underneath, so it reads on night and day alike. */
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 4rem;
    padding-inline: var(--gutter);
    color: #fff;
    mix-blend-mode: difference;
    transition: transform 600ms var(--ease-out);
  }

  :global(.nav-hidden) .nav {
    transform: translateY(-100%);
  }

  /* Back for whoever tabs into it, however far down the page. */
  :global(.nav-hidden) .nav:focus-within {
    transform: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    font-size: var(--t-small);
    text-decoration: none;
    opacity: 0.72;
    transition: opacity 200ms var(--ease-out);
  }

  ul a:hover {
    opacity: 1;
  }

  .end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theme {
    position: relative;
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.28);
  }

  .theme[hidden] {
    display: none;
  }

  .theme button {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    opacity: 0.6;
    cursor: pointer;
    transition:
      opacity 200ms var(--ease-out),
      background-color 300ms var(--ease-out);
  }

  .theme button:hover {
    opacity: 1;
  }

  .theme button[aria-pressed="true"] {
    opacity: 1;
    background: rgb(255 255 255 / 0.2);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    height: 2.125rem;
    padding-inline: 0.9375rem;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-size: var(--t-small);
    font-weight: 520;
    white-space: nowrap;
    text-decoration: none;
    transition: transform 400ms var(--ease-out);
  }

  .cta:active {
    transform: scale(0.96);
  }

  @media (max-width: 760px) {
    nav {
      display: none;
    }
    .theme button {
      width: 1.625rem;
      height: 1.625rem;
    }
    .nav {
      grid-template-columns: 1fr auto;
    }
  }

  /* A phone has room for the mark, the theme and the button, not the name as well: it is the
     hero's first line. */
  @media (max-width: 400px) {
    .brand span {
      display: none;
    }
  }
</style>
