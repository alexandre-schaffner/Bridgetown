---
// The top of a MacBook, drawn at SCREEN_W points and scaled to fit (scripts/island.ts sets
// --k): menu bar, a terminal where the work is, the hardware notch, and Bridgetown's island in
// it. The notch chapter and the film rigs use it.
import ArchMark from "./ArchMark.astro";
import Icon from "./Icon.astro";
import Island from "./Island.astro";
import Pointer from "./Pointer.astro";
import { NOTCH, SCREEN_W } from "../lib/notch";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const geometry = { "--screen-w": `${SCREEN_W}px`, "--notch-w": `${NOTCH.width}px`, "--notch-h": `${NOTCH.height}px` };
---

<div class:list={["mac", className]} data-mac style={geometry}>
  <div class="bezel">
    <div
      class="screen"
      data-screen
      role="img"
      aria-label="The top of a MacBook screen. Bridgetown hangs from the notch: it shows agents at work, drops a banner when something needs you, and unfolds into the full app."
    >
      <div class="wallpaper" aria-hidden="true">
        <ArchMark size={460} class="wall-arch" />
      </div>

      <div class="menubar" aria-hidden="true">
        <span class="app">Terminal</span>
        <span>Shell</span><span>Edit</span><span>View</span><span>Window</span><span>Help</span>
        <span class="spacer"></span>
        <Icon name="wifi" size={14} stroke={2} />
        <Icon name="battery-full" size={17} stroke={1.6} />
        <span>Sun 4 Oct</span>
        <span>9:41</span>
      </div>

      <div class="window" aria-hidden="true">
        <div class="chrome"><i></i><i></i><i></i><span>api — zsh</span></div>
        <pre data-term><span class="p">~/code/api</span> git switch -c search-cache
Switched to a new branch 'search-cache'
<span class="p">~/code/api</span> bun test search
 ✓ caches by normalized query <span class="f">[3.1ms]</span>
 ✓ evicts after ttl <span class="f">[0.8ms]</span>
 ✓ skips cache for signed requests <span class="f">[1.2ms]</span>

 3 pass
 0 fail
<span class="p">~/code/api</span> <span class="caret"></span></pre>
      </div>

      <div class="hw-notch" aria-hidden="true"></div>
      <Island />

      <Pointer class="cursor" data-cursor />
    </div>
  </div>
</div>

<style>
  /* The machine: a bezel with rounded top corners, cut off below so the screen's top is the stage. */
  .mac {
    --k: 0.9;
    --ox: 0px;
    min-width: 0;
    width: min(100% - 2 * var(--gutter), 92rem);
    margin-inline: auto;
  }

  .bezel {
    position: relative;
    /* Zoomed in on a phone, the screen is cut short so the words below still fit. */
    height: calc(min(548px * var(--k), 44svh) + 14px);
    padding: 14px 14px 0;
    border-radius: 26px 26px 0 0;
    background: #0d0e10;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      0 0 0 1px oklch(0.19 0.008 255 / 0.18);
    overflow: hidden;
    mask-image: linear-gradient(180deg, #000 86%, transparent);
    -webkit-mask-image: linear-gradient(180deg, #000 86%, transparent);
  }

  /* Drawn at full size and scaled to fit (scripts/island.ts sets --k). */
  .screen {
    position: relative;
    width: var(--screen-w);
    height: 620px;
    transform: translateX(var(--ox)) scale(var(--k));
    transform-origin: 0 0;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
    color: #1d1d1f;
    font-family: var(--sans);
  }

  .wallpaper {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 90% at 50% 120%, oklch(0.86 0.06 240) 0%, oklch(0.92 0.035 240 / 0.7) 38%, transparent 72%),
      radial-gradient(40% 50% at 12% 10%, oklch(0.97 0.012 70 / 0.8), transparent 70%),
      linear-gradient(180deg, oklch(0.975 0.006 250), oklch(0.945 0.014 245));
  }

  /* The arch in daylight, far off: the wallpaper Bridgetown ships with. Its halo is painted
     rather than filtered: a 60px drop-shadow here cost Safari a dropped frame or two each time
     the machine came on screen. */
  .wallpaper :global(.wall-arch) {
    position: absolute;
    left: 66%;
    top: 170px;
    color: rgb(255 255 255 / 0.72);
  }

  .wallpaper::before {
    content: "";
    position: absolute;
    left: calc(66% - 60px);
    top: 110px;
    width: 597px;
    height: 580px;
    background: radial-gradient(closest-side, oklch(0.8 0.08 240 / 0.5), oklch(0.8 0.08 240 / 0.2) 72%, transparent);
  }

  .menubar {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 18px;
    height: var(--notch-h);
    padding: 0 16px;
    font-size: 13px;
    background: rgb(255 255 255 / 0.5);
    backdrop-filter: blur(20px) saturate(1.6);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
  }

  .menubar .app {
    font-weight: 650;
  }

  .spacer {
    flex: 1;
  }

  .hw-notch {
    position: absolute;
    top: 0;
    left: calc(50% - var(--notch-w) / 2);
    width: var(--notch-w);
    height: var(--notch-h);
    background: #000;
    border-radius: 0 0 10px 10px;
    z-index: 4;
  }

  .window {
    position: absolute;
    left: 120px;
    top: 150px;
    width: 640px;
    height: 420px;
    border-radius: 11px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.94);
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.18),
      0 22px 44px -10px rgb(0 0 0 / 0.25);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 12px;
    background: rgb(246 246 248);
    border-bottom: 0.5px solid rgb(0 0 0 / 0.1);
  }

  .chrome i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #d9d9dc;
  }

  .chrome span {
    flex: 1;
    margin-right: 60px;
    text-align: center;
    font-size: 12.5px;
    font-weight: 600;
    color: #6e6e73;
  }

  pre {
    margin: 0;
    padding: 14px 16px;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.6;
  }

  pre .p {
    color: #0a63c7;
  }

  pre .f {
    color: #8a8a8e;
  }

  .caret {
    display: inline-block;
    width: 7px;
    height: 15px;
    vertical-align: -3px;
    background: #1d1d1f;
    animation: mac-blink 1.1s steps(1) infinite;
  }

  @keyframes mac-blink {
    50% {
      opacity: 0;
    }
  }

  .screen :global(.cursor) {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 6;
    opacity: 0;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.3));
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
