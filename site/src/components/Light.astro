---
// Night again. The arch returns and its light runs through the states the app uses on its
// Dock tile. The scene does the lighting; this is the words and the Dock icons beside them.
import { Picture } from "astro:assets";
import rest from "../assets/states/rest.png";
import working from "../assets/states/working.png";
import needsYou from "../assets/states/needs-you.png";
import paused from "../assets/states/paused.png";

const states = [
  { id: "rest", src: rest, name: "Cool white", text: "Nothing is waiting on you." },
  { id: "working", src: working, name: "Blue lamps", text: "Agents are at work." },
  { id: "needs-you", src: needsYou, name: "Amber", text: "A decision is yours." },
  { id: "paused", src: paused, name: "Dim", text: "Paused. Alerts are still read; nothing starts on its own." },
];
---

<section class="light night" id="light" data-light data-land="stage" aria-labelledby="light-title">
  <div class="stage">
    <div class="intro">
      <h2 id="light-title" class="display">Read the light.</h2>
      <p class="lead">The same light burns behind the arch on your Dock icon, so you can tell from across the room.</p>
      <p class="hint">Pick a light<span class="drag">, or drag the arch to walk around it</span>.</p>
    </div>

    <ol class="states" data-light-states>
      {
        states.map((s, i) => (
          <li data-light-state={s.id} class:list={[i === 0 && "on"]}>
            <button type="button" class="pick" data-light-pick={s.id} aria-pressed={i === 0 ? "true" : "false"}>
            <Picture
              src={s.src}
              formats={["avif", "webp"]}
              widths={[96, 192]}
              width={192}
              height={192}
              sizes="56px"
              alt=""
              class="tile"
              loading="lazy"
            />
            <span class="name">{s.name}</span>
            <span class="text">{s.text}</span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Dusk and dawn: the day melts into the night in a run-up before the stage, and back after it. */
  .light {
    padding-block: 70svh;
  }

  .light::before,
  .light::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 70svh;
    pointer-events: none;
    z-index: -1;
  }

  .light::before {
    top: 0;
    background: linear-gradient(180deg, var(--day), transparent);
  }

  .light::after {
    bottom: 0;
    background: linear-gradient(0deg, var(--day), transparent);
  }
  .stage {
    display: grid;
    align-content: space-between;
    gap: 3rem;
    min-height: 100svh;
    padding: 7rem var(--gutter) 3.5rem;
  }

  .intro {
    display: grid;
    gap: 1.25rem;
  }

  .stage {
    position: relative;
  }

  /* Shadow under the words, top and bottom, so they hold over lit stone. */
  .stage::before,
  .stage::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    z-index: -1;
    background: linear-gradient(180deg, transparent, oklch(0.1 0.006 255 / 0.75));
    pointer-events: none;
  }

  .stage::before {
    inset: 0 0 auto;
    height: 40%;
    background: linear-gradient(0deg, transparent, oklch(0.1 0.006 255 / 0.55));
  }

  .intro .display {
    font-size: var(--t-h1);
    letter-spacing: -0.036em;
  }

  .intro .lead {
    max-width: 28rem;
  }

  .hint {
    font-size: var(--t-small);
    color: var(--night-faint);
  }

  .hint:not(:global(html.js) *) {
    display: none;
  }

  /* Only a mouse can walk the camera (scripts/main.ts), and not under Reduce Motion. */
  @media not (pointer: fine), (prefers-reduced-motion: reduce) {
    .drag {
      display: none;
    }
  }

  .states {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pick {
    all: unset;
    display: contents;
    cursor: pointer;
  }

  .pick:focus-visible :global(.tile) {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
    border-radius: 14px;
  }

  .states li:hover {
    opacity: 1 !important;
  }

  .states li {
    cursor: pointer;
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    grid-template-areas: "tile name" "tile text";
    column-gap: 0.875rem;
    align-content: start;
    transition:
      opacity 600ms var(--ease-out),
      filter 600ms var(--ease-out);
  }

  .states :global(.tile) {
    grid-area: tile;
    width: 3.5rem;
    height: 3.5rem;
    margin: -0.375rem 0 0 -0.375rem;
    transition: transform 700ms var(--ease-out);
  }

  .name {
    grid-area: name;
    font-weight: 560;
  }

  .text {
    grid-area: text;
    font-size: var(--t-small);
    color: var(--night-dim);
  }

  :global(html.js) .states li:not(.on) {
    opacity: 0.38;
    filter: saturate(0.3);
  }

  :global(html.js) .states li.on :global(.tile) {
    transform: scale(1.12);
  }

  :global(html.js) .light {
    height: calc(420svh + 140svh);
  }

  :global(html.js) .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
  }

  /* Narrow: four tiles in a row, and only the lit one's words beneath them. */
  @media (max-width: 900px) {
    .states {
      grid-template-columns: 1fr 1fr;
    }
    :global(html.js) .states {
      position: relative;
      grid-template-columns: repeat(4, 3.5rem);
      justify-content: space-between;
      padding-bottom: 4.75rem;
    }
    :global(html.js) .states li {
      display: block;
    }
    :global(html.js) .states :global(.tile) {
      margin: 0;
    }
    :global(html.js) .states .name,
    :global(html.js) .states .text {
      position: absolute;
      left: 0;
      right: 0;
      opacity: 0;
      transition: opacity 400ms var(--ease-out);
    }
    :global(html.js) .states .name {
      bottom: 2.75rem;
    }
    :global(html.js) .states .text {
      bottom: 0;
      min-height: 2.5rem;
    }
    :global(html.js) .states li.on .name,
    :global(html.js) .states li.on .text {
      opacity: 1;
    }
  }
</style>
