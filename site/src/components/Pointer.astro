---
// The macOS pointer, drawn in its 22-point box at `size`: the notch chapter's cursor, and the
// films'. Its other attributes (class, data-*) go on the <svg>.
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"svg"> & { size?: number };
const { size = 22, ...attributes } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 22 22" aria-hidden="true" {...attributes}
  ><path d="M4 2.5v15.2l3.9-3.6 2.5 5.6 2.6-1.1-2.4-5.5h5.3z" fill="#000" stroke="#fff" stroke-width="1.2" stroke-linejoin="round"
  ></path></svg
>
