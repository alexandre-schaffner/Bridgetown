---
// Day. One alert's whole path, Diagnose to Deploy, as a horizontal reel pinned in place.
// Each step shows the thing that proves it happened. Two steps are yours, and those two are
// the app's own screens: the session that settles them, before and after the merge.
import AppShot from "./AppShot.astro";
import { BUILD_LOG, FIX, PATH } from "../lib/story";
import sessionMerge from "../assets/app/session-merge.png";
import sessionMerged from "../assets/app/session-merged.png";

/** The session's detail, from its title through the decision, in the captures' pixels. */
const decision = { x: 761, y: 65, width: 1059, height: 674 };
---

<section class="journey day" id="journey" data-journey aria-labelledby="journey-title">
  <div class="pin" data-journey-pin>
    <header class="chapter-head head wrap">
      <h2 id="journey-title" class="display">Agents take it all the way.</h2>
      <p class="lead">
        From the first log line to the deploy, every step leaves something you can open: a diagnosis, a diff, a pull
        request, a check, a tracker entry.
      </p>
    </header>

    <ol class="rail wrap" aria-hidden="true">
      {
        PATH.map(({ step, yours }) => (
          <li data-rail class:list={[yours && "yours"]}>
            <i />
            <span>{step}</span>
          </li>
        ))
      }
    </ol>

    <div class="viewport">
      <ol class="track" data-track>
        <li class="frame">
          <p class="step">1 · Diagnose</p>
          <h3>Finds what broke, and says so plainly.</h3>
          <p class="caption">
            The agent reads the alert, the logs and the dashboards around it in its own worktree.
          </p>
          <div class="panel">
            <p class="panel-head"><span>merkl-app v2.15.0 · Build</span><span class="fail">Failed</span></p>
            <pre class="log">{BUILD_LOG.map(([kind, text]) => <span class:list={["ll", kind]}>{text}</span>)}</pre>
            <p class="diag">
              <b>Diagnosis</b> The sparkline imports <code>d3-shape/src/curve</code>, a path only d3 v7 exports, and a
              lockfile dedupe resolved v6. The package root works on both.
            </p>
          </div>
        </li>

        <li class="frame">
          <p class="step">2 · Fix</p>
          <h3>Changes the code, on its own branch.</h3>
          <p class="caption">It edits only its worktree, then runs the tests that cover the change.</p>
          <div class="panel code">
            <p class="panel-head mono"><span>apps/app/src/components/Sparkline.tsx</span><span class="faint">+1 −2</span></p>
            <pre>{FIX.map(([n, kind, text]) => (
              <span class:list={["dl", kind]}><span class="ln">{n}</span>{text}{"\n"}</span>
            ))}</pre>
            <p class="panel-foot mono"><span class="ok">✓</span> vite build · 312 pass · 0 fail</p>
          </div>
        </li>

        <li class="frame">
          <p class="step">3 · Draft PR</p>
          <h3>Opens a draft, with the reasoning attached.</h3>
          <p class="caption">The diagnosis goes in the description, so a reviewer starts with context.</p>
          <div class="panel">
            <p class="pr-title">fix(app): import d3-shape from the package root <span class="faint">#3345</span></p>
            <p class="pr-meta">
              <span class="pill">Draft</span>
              <span class="mono faint">fix-bt-app-d3-shape</span>
            </p>
            <div class="pr-body">
              <p><b>Root cause.</b> <code>d3-shape/src/curve</code> exists only in d3 v7; the lockfile resolved v6.</p>
              <p><b>Fix.</b> Import the curve and the line from the package root.</p>
              <p><b>Tested.</b> The build passes, and the sparkline draws as before.</p>
            </div>
          </div>
        </li>

        <li class="frame">
          <p class="step">4 · Second review</p>
          <h3>Another vendor's model reads every diff.</h3>
          <p class="caption">
            Codex reviews in a read-only sandbox. Blocking findings go back to the agent; nitpicks are dropped.
          </p>
          <div class="panel">
            <ul class="rounds">
              <li>
                <span class="r">Round 1</span>
                <span>Two other charts still import from <code>d3-shape/src</code>.</span>
                <span class="tag tag-amber">Blocking</span>
              </li>
              <li>
                <span class="r"></span>
                <span>Sort the d3 imports.</span>
                <span class="tag">Dropped</span>
              </li>
              <li>
                <span class="r"></span>
                <span>Agent: moves both to the package root.</span>
                <span class="tag">Fixed</span>
              </li>
              <li>
                <span class="r">Round 2</span>
                <span>No blocking findings.</span>
                <span class="tag tag-green">Passed</span>
              </li>
            </ul>
          </div>
        </li>

        <li class="frame">
          <p class="step">5 · CI</p>
          <h3>Waits for green, and fixes what isn't.</h3>
          <p class="caption">The PR leaves draft once the review passes. A failing check goes back to the agent.</p>
          <div class="panel">
            <ul class="checks">
              <li><span class="ok">✓</span> lint <span class="faint mono">18s</span></li>
              <li><span class="ok">✓</span> typecheck <span class="faint mono">44s</span></li>
              <li><span class="ok">✓</span> unit <span class="faint mono">1m 08s</span></li>
              <li><span class="ok">✓</span> build <span class="faint mono">2m 11s</span></li>
              <li><span class="ok">✓</span> e2e · charts <span class="faint mono">3m 05s</span></li>
              <li><span class="ok">✓</span> preview <span class="faint mono">1m 32s</span></li>
            </ul>
          </div>
        </li>

        <li class="frame">
          <p class="step">6 · Review request</p>
          <h3>Asks a person to look.</h3>
          <p class="caption">Once CI is green, it posts in your approvals channel with a link to a guided walkthrough.</p>
          <div class="panel slack">
            <p class="slack-ch mono">#product-approvals</p>
            <div class="slack-msg">
              <span class="avatar">A</span>
              <div>
                <p><b>Alex</b> <span class="faint">via Bridgetown · 10:12</span></p>
                <p>🤖 <span class="link">PR #3345</span> is green and ready for review: import d3-shape from the package root. <span class="link">Walkthrough</span></p>
              </div>
            </div>
          </div>
        </li>

        <li class="frame yours">
          <p class="step"><i class="dot dot-amber" aria-hidden="true"></i> 7 · Merge · Yours</p>
          <h3>You press Merge.</h3>
          <p class="caption">Approved and green, it waits in Needs you. Merging is always your click.</p>
          <div class="panel shot">
            <AppShot
              src={sessionMerge}
              crop={decision}
              edge
              alt="Bridgetown's session for merkl-app v2.15.0, Build failed: ready to merge. Merge fix(app): import d3-shape from the package root, #3345, approved by julien, CI green with 6 checks, Codex passed. A Merge button."
            />
          </div>
        </li>

        <li class="frame yours">
          <p class="step"><i class="dot dot-amber" aria-hidden="true"></i> 8 · Release · Yours</p>
          <h3>You cut the release.</h3>
          <p class="caption">The next version is worked out for you. Tags are never pushed by an agent.</p>
          <div class="panel shot">
            <AppShot
              src={sessionMerged}
              crop={decision}
              edge
              alt="The same session, merged and ready to release. Ship merkl-app v2.15.0: merged #3345; cutting app-v2.15.1 starts the deploy, and approval stays with the reviewers. A Cut app-v2.15.1 button."
            />
          </div>
        </li>

        <li class="frame">
          <p class="step">9 · Deploy</p>
          <h3>Follows it to production.</h3>
          <p class="caption">
            It is done when the release tracker confirms the deploy, and not before. Then it says so in the alert's thread.
          </p>
          <div class="panel">
            <p class="deployed"><i class="dot dot-green" aria-hidden="true"></i> Deployed app-v2.15.1 <span class="faint">production · 10:31</span></p>
            <div class="slack-msg">
              <span class="avatar">A</span>
              <div>
                <p><b>Alex</b> <span class="faint">via Bridgetown · in thread</span></p>
                <p>🤖 Deployed app-v2.15.1 ✓</p>
              </div>
            </div>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .journey {
    padding-block: clamp(6rem, 12vh, 9rem) clamp(5rem, 10vh, 8rem);
    overflow: clip;
  }

  /* The rail follows close under it, and it stacks at 980px with the rest of the reel. */
  .head {
    margin-bottom: 0;
  }

  .head .display {
    max-width: 12ch;
  }

  .rail {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 4px;
    margin-top: clamp(2.5rem, 5vh, 3.5rem);
    margin-bottom: clamp(2rem, 4vh, 3rem);
    padding: 0;
    list-style: none;
  }

  .rail li {
    display: grid;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .rail i {
    height: 3px;
    border-radius: 2px;
    background: var(--line);
    transition: background-color 400ms var(--ease-out);
  }

  .rail li.done i {
    background: var(--ink);
  }

  .rail li.done {
    color: var(--ink);
  }

  .rail li.yours.done i {
    background: var(--amber);
  }

  .viewport {
    overflow: visible;
  }

  .track {
    display: grid;
    gap: clamp(3rem, 6vh, 5rem);
    margin: 0;
    padding: 0 var(--gutter);
    list-style: none;
  }

  .frame {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-areas:
      "step panel"
      "title panel"
      "caption panel";
    grid-template-rows: auto auto 1fr;
    column-gap: clamp(2rem, 4vw, 4rem);
    row-gap: 0.875rem;
    align-items: start;
  }

  .step {
    grid-area: step;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-faint);
  }

  .yours .step {
    color: var(--ink);
  }

  .frame h3 {
    grid-area: title;
    font-size: clamp(1.75rem, 1.6vw + 1rem, 2.625rem);
    line-height: 1.08;
    letter-spacing: -0.028em;
    max-width: 14ch;
  }

  .caption {
    grid-area: caption;
    max-width: 26rem;
    color: var(--ink-dim);
  }

  /* Artifacts: the app's own dark surfaces. */
  .panel {
    grid-area: panel;
    display: grid;
    gap: 0.875rem;
    padding: 1.25rem;
    border-radius: 14px;
    background: #000;
    color: var(--ui-text);
    font-size: 0.875rem;
    box-shadow: 0 30px 60px -36px oklch(0.19 0.008 255 / 0.55);
  }

  .faint {
    color: var(--ui-faint);
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    color: var(--ui-dim);
    font-weight: 500;
  }

  .fail {
    color: var(--red);
  }

  /* The build's own words, a line each, wrapped rather than scrolled: the error is the long
     one. Wrapped as prose, so no space hangs past the panel's edge where a line breaks. */
  .log {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.65;
    white-space: normal;
    overflow-wrap: anywhere;
    color: var(--ui-dim);
  }

  .ll {
    display: block;
  }

  .ll.ok {
    color: var(--ui-faint);
  }

  .ll.err {
    color: oklch(0.72 0.14 22);
  }

  /* The app's screen fills its panel, edge to edge, its hairline at the panel's corners. */
  .panel.shot {
    --radius: 14px;
    padding: 0;
    overflow: hidden;
  }

  .diag {
    padding-top: 0.875rem;
    border-top: 0.5px solid var(--ui-hairline);
    line-height: 1.55;
    color: var(--ui-dim);
  }

  .diag b {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--ui-text);
    font-weight: 600;
  }

  code {
    font-family: var(--mono);
    font-size: 0.92em;
    padding: 0.05em 0.3em;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.08);
    color: var(--ui-text);
  }

  .code pre {
    --ln-w: 2.25rem;
    margin: 0;
    padding: 0.75rem 0;
    border-block: 0.5px solid var(--ui-hairline);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    overflow-x: auto;
    color: var(--ui-dim);
    /* One column as wide as the longest line, so where the diff scrolls sideways each line's
       colour reaches its end (a phone wraps it instead, below). */
    display: grid;
  }

  .dl {
    padding-right: 1rem;
  }

  .ln {
    display: inline-block;
    width: var(--ln-w);
    color: rgb(255 255 255 / 0.3);
  }

  .dl.del {
    color: oklch(0.72 0.14 22);
    background: oklch(0.6 0.19 22 / 0.1);
  }

  .dl.add {
    color: oklch(0.8 0.13 158);
    background: oklch(0.62 0.12 158 / 0.1);
  }

  .panel-foot {
    color: var(--ui-dim);
  }

  .ok {
    color: var(--green);
  }

  .pr-title {
    font-size: 1.0625rem;
    font-weight: 560;
    letter-spacing: -0.012em;
  }

  .pr-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .pill {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    box-shadow: 0 0 0 0.5px var(--ui-outline) inset;
    color: var(--ui-dim);
  }

  .pr-body {
    display: grid;
    gap: 0.375rem;
    padding-top: 0.875rem;
    border-top: 0.5px solid var(--ui-hairline);
    color: var(--ui-dim);
  }

  .pr-body b {
    color: var(--ui-text);
    font-weight: 560;
  }

  .rounds,
  .checks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rounds li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.625rem 0;
    color: var(--ui-dim);
  }

  .rounds li + li {
    border-top: 0.5px solid var(--ui-hairline);
  }

  .r {
    color: var(--ui-text);
    font-weight: 500;
  }

  .tag {
    padding: 0.0625rem 0.4375rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    background: rgb(255 255 255 / 0.06);
    color: var(--ui-dim);
  }

  .tag-amber {
    color: var(--amber);
    background: oklch(0.8 0.15 74 / 0.14);
  }

  .tag-green {
    color: var(--green);
    background: oklch(0.62 0.12 158 / 0.16);
  }

  .checks li {
    display: grid;
    grid-template-columns: 1.25rem 1fr auto;
    padding: 0.5625rem 0;
  }

  .checks li + li {
    border-top: 0.5px solid var(--ui-hairline);
  }

  .slack {
    gap: 0.75rem;
  }

  .slack-ch {
    color: var(--ui-dim);
  }

  .slack-msg {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.75rem;
    line-height: 1.5;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    background: oklch(0.42 0.06 255);
    font-weight: 600;
  }

  .link {
    color: oklch(0.72 0.14 252);
  }

  .yours .panel {
    box-shadow:
      0 0 0 1px oklch(0.8 0.15 74 / 0.55),
      0 30px 60px -36px oklch(0.19 0.008 255 / 0.55);
  }

  .deployed {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    padding-bottom: 0.875rem;
    border-bottom: 0.5px solid var(--ui-hairline);
  }

  /* Wide screens with script: the frames sit in a row and the section is pinned while they pass. */
  @media (min-width: 981px) {
    :global(html.js) .journey {
      padding-block: 0;
    }
    :global(html.js) .pin {
      display: flex;
      flex-direction: column;
      justify-content: safe center;
      height: 100svh;
      padding-top: 4.5rem;
    }
    :global(html.js) .track {
      display: flex;
      gap: clamp(5rem, 10vw, 11rem);
      width: max-content;
      padding-inline: var(--gutter);
      will-change: transform;
    }
    :global(html.js) .frame {
      width: min(76vw, 64rem);
    }
    :global(html.js) .head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    }
    :global(html.js) .head .display {
      font-size: clamp(2.25rem, 2.4vw + 1rem, 3.5rem);
      max-width: none;
    }
  }

  @media (max-width: 980px) {
    .head {
      grid-template-columns: 1fr;
    }
    .rail {
      display: none;
    }
    .viewport {
      margin-top: clamp(3rem, 7vh, 4.5rem);
    }
    .frame {
      grid-template-columns: 1fr;
      grid-template-areas: "step" "title" "caption" "panel";
    }
    .panel {
      margin-top: 0.75rem;
    }
  }

  /* A phone: the diff wraps under its line numbers rather than scrolling sideways. */
  @media (max-width: 600px) {
    .code pre {
      font-size: 0.75rem;
      white-space: pre-wrap;
    }
    .dl {
      padding-left: var(--ln-w);
      text-indent: calc(-1 * var(--ln-w));
    }
    .ln {
      text-indent: 0;
    }
  }

  /* Each frame plays its proof once, when it first reaches the middle: .played, from reel.ts when
     the frames are in a row, from scripts/main.ts when they are stacked. */
  :global(html.js) .frame .ll,
  :global(html.js) .frame .dl,
  :global(html.js) .frame .rounds li,
  :global(html.js) .frame .checks li,
  :global(html.js) .frame .pr-body p,
  :global(html.js) .frame .diag {
    opacity: 0;
    translate: -0.75rem 0;
    filter: blur(4px);
    transition:
      opacity 500ms var(--ease-out),
      translate 700ms var(--ease-out),
      filter 500ms var(--ease-out);
  }

  :global(html.js) .played .ll,
  :global(html.js) .played .dl,
  :global(html.js) .played .rounds li,
  :global(html.js) .played .checks li,
  :global(html.js) .played .pr-body p,
  :global(html.js) .played .diag {
    opacity: 1;
    translate: 0 0;
    filter: none;
  }

  .ll:nth-child(1), .dl:nth-child(1), .rounds li:nth-child(1), .checks li:nth-child(1), .pr-body p:nth-child(1) { transition-delay: 150ms !important; }
  .ll:nth-child(2), .dl:nth-child(2), .rounds li:nth-child(2), .checks li:nth-child(2), .pr-body p:nth-child(2) { transition-delay: 450ms !important; }
  .ll:nth-child(3), .dl:nth-child(3), .rounds li:nth-child(3), .checks li:nth-child(3), .pr-body p:nth-child(3) { transition-delay: 750ms !important; }
  .ll:nth-child(4), .dl:nth-child(4), .rounds li:nth-child(4), .checks li:nth-child(4) { transition-delay: 1050ms !important; }
  .dl:nth-child(5), .checks li:nth-child(5) { transition-delay: 1250ms !important; }
  .dl:nth-child(6), .checks li:nth-child(6) { transition-delay: 1400ms !important; }
  .dl:nth-child(7) { transition-delay: 1550ms !important; }
  .diag { transition-delay: 1700ms !important; }

  :global(html.js) .played .deployed .dot {
    animation: journey-land 900ms var(--ease-out) 300ms both;
  }

  @keyframes journey-land {
    from {
      transform: scale(0);
      box-shadow: 0 0 0 0 oklch(0.62 0.12 158 / 0.6);
    }
    60% {
      transform: scale(1.4);
    }
    to {
      transform: none;
      box-shadow: 0 0 0 10px oklch(0.62 0.12 158 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .frame .ll,
    :global(html.js) .frame .dl,
    :global(html.js) .frame .rounds li,
    :global(html.js) .frame .checks li,
    :global(html.js) .frame .pr-body p,
    :global(html.js) .frame .diag {
      opacity: 1;
      translate: 0 0;
      filter: none;
    }
  }
</style>
