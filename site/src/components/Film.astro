---
// The films, in a dialog over the page: a link to one (`<a href="/media/….mp4"
// data-open-film>`) plays it here, with its …-poster.jpg. Without script, the link opens the
// file.
import Icon from "./Icon.astro";
---

<dialog class="film" data-film aria-label="The Bridgetown film">
  <div class="player">
    <video controls playsinline preload="none" data-film-video></video>
  </div>
  <form method="dialog">
    <button class="close" aria-label="Close the film"><Icon name="x" size={18} stroke={2} /></button>
  </form>
</dialog>

<script>
  import { $, $$ } from "../lib/dom";
  import { lenis } from "../scripts/scroll";

  const film = $<HTMLDialogElement>("[data-film]");
  if (film) {
    const video = $<HTMLVideoElement>("[data-film-video]", film)!;
    for (const a of $$<HTMLAnchorElement>("a[data-open-film]")) {
      a.addEventListener("click", (e) => {
        // ⌘-click and the like still open the file.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        const src = a.getAttribute("href")!;
        if (video.getAttribute("src") !== src) {
          video.poster = src.replace(/\.mp4$/, "-poster.jpg");
          video.src = src;
        }
        film.showModal();
        lenis?.stop();
        void video.play().catch(() => {});
      });
    }
    film.addEventListener("close", () => {
      video.pause();
      lenis?.start();
    });
    // A click on the backdrop closes it.
    film.addEventListener("click", (e) => {
      if (e.target === film) film.close();
    });
  }
</script>

<style>
  .film {
    width: min(100vw - 2 * var(--gutter), 160vh, 96rem);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .film::backdrop {
    background: oklch(0.08 0.006 255 / 0.86);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .film[open] {
    animation: film-arrive 700ms var(--ease-out);
  }

  .film[open]::backdrop {
    animation: film-fade 500ms var(--ease-out);
  }

  @keyframes film-arrive {
    from {
      opacity: 0;
      transform: scale(0.92);
      filter: blur(12px);
    }
  }

  @keyframes film-fade {
    from {
      opacity: 0;
    }
  }

  .player {
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 0 0 1px oklch(1 0 0 / 0.1);
  }

  video {
    width: 100%;
    height: 100%;
    display: block;
  }

  .close {
    position: absolute;
    top: -3.25rem;
    right: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: oklch(1 0 0 / 0.12);
    color: #fff;
    cursor: pointer;
    transition: background-color 200ms var(--ease-out);
  }

  .close:hover {
    background: oklch(1 0 0 / 0.22);
  }
</style>
