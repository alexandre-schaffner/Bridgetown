---
// Night, last. The arch at rest, and the one thing to do next.
import ArchMark from "./ArchMark.astro";
import Icon from "./Icon.astro";
import { download } from "../lib/download";
---

<section class="finale night" id="download" data-finale data-land="stage" aria-labelledby="download-title">
  <div class="stage">
    <div class="ask">
      <h2 id="download-title" class="display">Let the agents take the first pass.</h2>
      <p class="lead">Works with the Slack, GitHub and Claude&nbsp;Code you already use.</p>
      <div class="get">
        <a class="button button-light" href={download.url} data-download>
          <Icon name="download" size={15} stroke={2.2} />
          Download for macOS
        </a>
        <p class="meta mono">{download.meta}</p>
        <p class="note">
          Not notarized yet. On first launch, open System Settings → Privacy &amp; Security → Open Anyway.
          <a href={download.notes}>Release notes and signatures</a>
        </p>
      </div>
    </div>

    <footer class="foot">
      <span class="brand"><ArchMark size={14} /> Bridgetown</span>
      <span>© 2026</span>
    </footer>
  </div>
</section>

<style>
  .finale {
    padding-top: 70svh;
    /* The pool of shadow behind the words reaches past the gutters; never past the page. */
    overflow-x: clip;
  }

  .finale::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 70svh;
    background: linear-gradient(180deg, var(--day), transparent);
    pointer-events: none;
    z-index: -1;
  }
  .stage {
    display: grid;
    align-content: space-between;
    min-height: 100svh;
    padding: 8rem var(--gutter) 2rem;
  }

  .ask {
    position: relative;
    display: grid;
    gap: 1.5rem;
    justify-items: center;
    text-align: center;
    padding-top: 2rem;
  }

  /* A pool of shadow behind the words, for when the stone is bright beneath them. */
  .ask::before {
    content: "";
    position: absolute;
    inset: -4rem -10vw;
    z-index: -1;
    background: radial-gradient(closest-side, oklch(0.1 0.006 255 / 0.7), transparent);
    pointer-events: none;
  }

  .ask .display {
    max-width: 14ch;
    font-size: var(--t-h1);
    letter-spacing: -0.038em;
    line-height: 1;
  }

  .ask .lead {
    max-width: 30rem;
  }

  /* Smoked glass: the arch is bright right behind it. */
  .get {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    width: min(100%, 30rem);
    margin-top: 1rem;
    padding: 0.5rem 1.5rem 1.25rem;
    border-radius: 1.75rem;
    background: oklch(0.14 0.006 255 / 0.62);
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .get .button {
    margin-top: 0.75rem;
  }

  .meta {
    color: var(--night-dim);
  }

  .note {
    font-size: var(--t-small);
    color: var(--night-dim);
  }

  .note a {
    display: block;
    margin-top: 0.25rem;
    color: var(--night-ink);
  }

  .foot {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--night-line);
    font-size: 0.8125rem;
    color: var(--night-faint);
  }

  .foot::before {
    content: "";
    position: absolute;
    inset: -3rem calc(-1 * var(--gutter)) -2rem;
    z-index: -1;
    background: linear-gradient(180deg, transparent, oklch(0.1 0.006 255 / 0.9) 55%);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--night-ink);
    font-weight: 560;
  }
</style>
