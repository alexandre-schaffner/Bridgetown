---
// Night, last. The arch at rest, and the one thing to do next.
import ArchMark from "./ArchMark.astro";
import { site } from "../site";
---

<section class="finale night" id="access" data-finale data-land="stage" aria-labelledby="access-title">
  <div class="stage">
    <div class="ask">
      <h2 id="access-title" class="display">Let the agents take the first pass.</h2>
      <p class="lead">
        Bridgetown is in early access for teams on macOS 14 or later, with Slack, GitHub and Claude Code.
      </p>
      <form class="form" data-access-form data-endpoint={site.accessEndpoint} novalidate>
        <label class="visually-hidden" for="access-email">Work email</label>
        <input
          id="access-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="you@company.com"
          aria-describedby="access-status"
        />
        <button class="button button-light" type="submit">Request early access</button>
        <p id="access-status" class="status" role="status" aria-live="polite"></p>
      </form>
    </div>

    <footer class="foot">
      <span class="brand"><ArchMark size={14} /> Bridgetown</span>
      <span>For macOS 14 Sonoma and later</span>
      <span>© 2026</span>
    </footer>
  </div>
</section>

<script>
  import { $ } from "../lib/dom";

  // Posts the address to PUBLIC_ACCESS_ENDPOINT; "access-sent" lets the light settle (scripts/main.ts).
  const form = $<HTMLFormElement>("[data-access-form]");
  if (form) {
    const input = $<HTMLInputElement>("input", form)!;
    const button = $<HTMLButtonElement>("button", form)!;
    const status = $("[role=status]", form)!;
    const say = (text: string, error = false) => {
      status.textContent = text;
      status.classList.toggle("error", error);
    };
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!input.checkValidity() || !email) {
        say("Enter an email address we can write to.", true);
        input.focus();
        return;
      }
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        say("Requests aren't open yet. Check back soon.", true);
        return;
      }
      button.disabled = true;
      button.textContent = "Sending…";
      say("");
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        say(`Thanks. We'll write to ${email} when there's a place for you.`);
        form.dispatchEvent(new Event("access-sent", { bubbles: true }));
      } catch {
        say("That didn't go through. Try again in a moment.", true);
      } finally {
        button.disabled = false;
        button.textContent = "Request early access";
      }
    });
  }
</script>

<style>
  .finale {
    padding-top: 70svh;
    /* The pool of shadow behind the words reaches past the gutters; never past the page. */
    overflow-x: clip;
  }

  .finale::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 70svh;
    background: linear-gradient(180deg, var(--day), transparent);
    pointer-events: none;
    z-index: -1;
  }
  .stage {
    display: grid;
    align-content: space-between;
    min-height: 100svh;
    padding: 8rem var(--gutter) 2rem;
  }

  .ask {
    position: relative;
    display: grid;
    gap: 1.5rem;
    justify-items: center;
    text-align: center;
    padding-top: 2rem;
  }

  /* A pool of shadow behind the words, for when the stone is bright beneath them. */
  .ask::before {
    content: "";
    position: absolute;
    inset: -4rem -10vw;
    z-index: -1;
    background: radial-gradient(closest-side, oklch(0.1 0.006 255 / 0.7), transparent);
    pointer-events: none;
  }

  .ask .display {
    max-width: 14ch;
    font-size: var(--t-h1);
    letter-spacing: -0.038em;
    line-height: 1;
  }

  .ask .lead {
    max-width: 30rem;
  }

  .form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
    width: min(100%, 30rem);
    margin-top: 1rem;
    padding: 0.375rem;
    border-radius: 999px;
    /* Smoked glass: the arch is bright right behind it. */
    background: oklch(0.14 0.006 255 / 0.62);
    box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  input {
    min-width: 0;
    height: 2.875rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--night-ink);
  }

  input::placeholder {
    color: var(--night-faint);
  }

  input:focus-visible {
    outline: none;
  }

  .form:focus-within {
    box-shadow:
      inset 0 0 0 1px oklch(1 0 0 / 0.32),
      0 0 0 4px oklch(0.63 0.19 252 / 0.35);
  }

  .button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .status {
    grid-column: 1 / -1;
    min-height: 1.25rem;
    padding-inline: 1rem;
    font-size: var(--t-small);
    color: var(--night-dim);
    text-align: left;
  }

  .status:empty {
    display: none;
  }

  .status:global(.error) {
    color: oklch(0.78 0.13 30);
  }

  .foot {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--night-line);
    font-size: 0.8125rem;
    color: var(--night-faint);
  }

  .foot::before {
    content: "";
    position: absolute;
    inset: -3rem calc(-1 * var(--gutter)) -2rem;
    z-index: -1;
    background: linear-gradient(180deg, transparent, oklch(0.1 0.006 255 / 0.9) 55%);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--night-ink);
    font-weight: 560;
  }

  @media (max-width: 560px) {
    .form {
      grid-template-columns: 1fr;
      border-radius: 1.5rem;
    }
  }
</style>
